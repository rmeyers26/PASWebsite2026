---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import heroPhoto from '../assets/images/star-tours-event-crowd.jpg';

const siteSettings = (await getEntry('site-settings', 'data'))!.data;

// From PAStimes, August 2026 (Vol. 77, Issue #12), "Benefits of PAS
// Membership" — the club's own published list, lightly tightened for a
// scannable card grid.
const benefits = [
  "Help PAS carry out its mission of astronomy outreach and education",
  "Support the Society's college scholarships for astronomy students",
  'Join the members-only email list and get PAStimes, our monthly newsletter',
  'Borrow from the PAS telescope loaner program',
  'Teach at PAS telescope workshops or mentor at star parties',
  'Join the Astro Imaging Special Interest Group (ASIG)',
  'Serve as a paid presenter in the Star Tours outreach program',
  'Buy used astronomy equipment from other members at 50% off',
  "Go on club trips to Arizona's darkest sites and top observatories",
  'Connect with professional astronomers through guest lectures and workshops',
  'Take on a leadership role — committee chair or officer',
];

const membershipTiers = [
  { name: 'Individual Membership', price: '$30', featured: true },
  { name: 'Family Membership', price: '$36' },
  { name: 'Student Membership', price: '$16' },
  { name: 'Lifetime Member', price: '$500' },
  { name: 'Lifetime Member 65+', price: '$250' },
];

const addOns = [
  { name: 'Name Badge', price: '$20', photo: siteSettings.nameBadgePhoto },
  { name: 'Embroidered Logo', price: '$10', photo: siteSettings.patchPhoto },
];
---

<BaseLayout
  title="Join"
  description="Become a member of the Phoenix Astronomical Society."
  image={heroPhoto}
>
  <Hero
    image={heroPhoto}
    alt="PAS members and guests gathered around a telescope at dusk, with string lights and desert cactus around them"
    eyebrow="Membership"
    title="Become Part of the PAS Community"
    subtitle="Open to everyone curious about astronomy — no telescope or experience required."
    tone="dark"
    focalPoint="50% 25%"
  />

  <section class="mx-auto max-w-4xl px-6 py-20">
    <h2 class="section-heading">Member Benefits</h2>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2">
      {
        benefits.map((benefit) => (
          <li class="flex items-start gap-3 rounded-lg border border-subtle bg-space-card px-5 py-4 text-ink-muted">
            <span class="mt-2 h-2 w-2 flex-none rounded-full bg-nebula-violet" aria-hidden="true" />
            {benefit}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="border-t border-subtle bg-space-card/40">
    <div class="mx-auto max-w-4xl px-6 py-20">
      <h2 class="section-heading">Membership Tiers</h2>
      <p class="mt-3 text-ink-muted">Recurring memberships are annual, January through December.</p>
      <p class="mt-4 inline-flex items-center gap-2 rounded-full border border-nebula-amber/40 bg-nebula-amber/10 px-4 py-1.5 text-sm text-nebula-amber">
        <span aria-hidden="true">&#9888;</span> Test mode — this form is a UI preview only. No PayPal account is connected and no charges occur.
      </p>

      <form id="membership-form" novalidate>
        <fieldset class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <legend class="sr-only">Choose a membership tier</legend>
          {
            membershipTiers.map((tier, index) => (
              <label class={`card tier-option ${tier.featured ? 'card-featured' : ''}`}>
                <input
                  type="radio"
                  name="tier"
                  value={tier.name}
                  data-price={tier.price}
                  required
                  checked={index === 0}
                  class="tier-option-input"
                />
                {tier.featured && <span class="glass-badge">Most Common</span>}
                <p class="mt-4 text-ink-primary">{tier.name}</p>
                <p class="mt-1 font-display text-2xl text-nebula-amber">{tier.price}</p>
              </label>
            ))
          }
        </fieldset>

        <h3 class="font-display mt-10 text-lg text-ink-primary">Optional Add-Ons</h3>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {
            addOns.map((item) => (
              <label class="card addon-option flex items-center justify-between">
                <span class="flex items-center gap-3">
                  <input type="checkbox" name="addon" value={item.name} data-price={item.price} />
                  {item.photo && (
                    <img src={item.photo} alt="" class="h-12 w-16 flex-none rounded object-contain" />
                  )}
                  <span class="text-ink-muted">{item.name}</span>
                </span>
                <span class="font-display text-ink-primary">{item.price}</span>
              </label>
            ))
          }
        </div>

        <h3 class="font-display mt-10 text-lg text-ink-primary">Your Information</h3>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          <div>
            <label for="firstName" class="text-sm text-ink-muted">First Name</label>
            <input id="firstName" name="firstName" type="text" autocomplete="given-name" required class="form-input mt-1" />
          </div>
          <div>
            <label for="lastName" class="text-sm text-ink-muted">Last Name</label>
            <input id="lastName" name="lastName" type="text" autocomplete="family-name" required class="form-input mt-1" />
          </div>
          <div class="sm:col-span-2">
            <label for="address1" class="text-sm text-ink-muted">Address Line 1</label>
            <input id="address1" name="address1" type="text" autocomplete="address-line1" required class="form-input mt-1" />
          </div>
          <div class="sm:col-span-2">
            <label for="address2" class="text-sm text-ink-muted">Address Line 2</label>
            <input id="address2" name="address2" type="text" autocomplete="address-line2" class="form-input mt-1" />
          </div>
          <div>
            <label for="city" class="text-sm text-ink-muted">City</label>
            <input id="city" name="city" type="text" autocomplete="address-level2" required class="form-input mt-1" />
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label for="state" class="text-sm text-ink-muted">State</label>
              <input
                id="state"
                name="state"
                type="text"
                autocomplete="address-level1"
                maxlength="2"
                placeholder="AZ"
                required
                class="form-input mt-1 uppercase"
              />
            </div>
            <div>
              <label for="zip" class="text-sm text-ink-muted">Zip Code</label>
              <input
                id="zip"
                name="zip"
                type="text"
                inputmode="numeric"
                autocomplete="postal-code"
                pattern="[0-9]{5}(-[0-9]{4})?"
                required
                class="form-input mt-1"
              />
            </div>
          </div>
          <div class="sm:col-span-2">
            <label for="phone" class="text-sm text-ink-muted">Phone Number</label>
            <input id="phone" name="phone" type="tel" autocomplete="tel" required class="form-input mt-1" />
          </div>
        </div>

        <button type="submit" class="paypal-test-btn mt-10">Pay with PayPal</button>
      </form>
    </div>
  </section>

  <section class="border-t border-subtle">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="section-heading">Ready to Join?</h2>
      <p class="mx-auto mt-4 max-w-xl text-ink-muted">
        We now offer a year-round membership, which means you can join at any time with no enrollment
        deadlines, and you'll receive a full 12 months of benefits. If you have any questions, our Membership
        Manager is happy to help at{' '}
        <a href="mailto:membership@pasaz.org" class="text-nebula-teal hover:underline">membership@pasaz.org</a>.
      </p>
      <a href="mailto:membership@pasaz.org" class="btn-primary mt-8">Email membership@pasaz.org</a>
    </div>
  </section>

  <div
    id="paypal-test-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 px-4"
    role="dialog"
    aria-modal="true"
    aria-labelledby="paypal-test-modal-title"
  >
    <div class="w-full max-w-sm rounded-lg border border-subtle bg-space-card p-6 shadow-xl">
      <p class="inline-flex items-center gap-2 rounded-full border border-nebula-amber/40 bg-nebula-amber/10 px-3 py-1 text-xs text-nebula-amber">
        TEST MODE — no PayPal integration yet
      </p>
      <h3 id="paypal-test-modal-title" class="font-display mt-4 text-lg text-ink-primary">
        Simulated PayPal Checkout
      </h3>
      <dl class="mt-3 space-y-1 text-sm text-ink-muted">
        <div class="flex justify-between"><dt>Name</dt><dd id="paypal-test-name" class="text-ink-primary">—</dd></div>
        <div class="flex justify-between"><dt>Address</dt><dd id="paypal-test-address" class="text-right text-ink-primary">—</dd></div>
        <div class="flex justify-between"><dt>Phone</dt><dd id="paypal-test-phone" class="text-ink-primary">—</dd></div>
        <div class="flex justify-between"><dt>Membership</dt><dd id="paypal-test-tier" class="text-ink-primary">—</dd></div>
        <div class="flex justify-between"><dt>Add-ons</dt><dd id="paypal-test-addons" class="text-ink-primary">—</dd></div>
        <div class="flex justify-between border-t border-subtle pt-1 font-display text-ink-primary">
          <dt>Total</dt><dd id="paypal-test-price">$0</dd>
        </div>
      </dl>
      <p class="mt-3 text-sm text-ink-muted">
        This is a placeholder for the real PayPal button flow. Nothing is charged and no membership is created.
      </p>
      <div class="mt-6 flex flex-col gap-2 sm:flex-row-reverse">
        <button type="button" id="paypal-test-simulate" class="btn-primary">Simulate Successful Payment</button>
        <button type="button" id="paypal-test-cancel" class="btn-secondary">Cancel</button>
      </div>
      <p id="paypal-test-result" class="mt-4 hidden text-sm text-nebula-teal" role="status"></p>
    </div>
  </div>
</BaseLayout>

<style>
  .paypal-test-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: 0.5rem;
    background-color: #ffc439;
    color: #1a1a1a;
    font-weight: 600;
    padding: 0.6rem 1rem;
    transition: filter 0.15s ease;
  }
  .paypal-test-btn:hover {
    filter: brightness(0.95);
  }

  .tier-option,
  .addon-option {
    position: relative;
    cursor: pointer;
    display: block;
  }
  .tier-option-input {
    position: absolute;
    top: 1rem;
    right: 1rem;
  }
  .tier-option:has(.tier-option-input:checked),
  .addon-option:has(input:checked) {
    outline: 2px solid var(--color-nebula-teal, #2dd4bf);
    outline-offset: 2px;
  }

  .form-input {
    width: 100%;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border-subtle, #3a3a4a);
    background-color: transparent;
    padding: 0.55rem 0.75rem;
    color: inherit;
  }
  .form-input:focus {
    outline: 2px solid var(--color-nebula-teal, #2dd4bf);
    outline-offset: 1px;
  }
</style>

<script>
  const form = document.getElementById('membership-form') as HTMLFormElement | null;
  const modal = document.getElementById('paypal-test-modal');
  const nameField = document.getElementById('paypal-test-name');
  const addressField = document.getElementById('paypal-test-address');
  const phoneField = document.getElementById('paypal-test-phone');
  const tierLabel = document.getElementById('paypal-test-tier');
  const addonsLabel = document.getElementById('paypal-test-addons');
  const priceLabel = document.getElementById('paypal-test-price');
  const result = document.getElementById('paypal-test-result');
  const simulateBtn = document.getElementById('paypal-test-simulate');
  const cancelBtn = document.getElementById('paypal-test-cancel');

  function parsePrice(value: string | undefined): number {
    return Number((value ?? '').replace(/[^0-9.]/g, '')) || 0;
  }

  function closeModal() {
    if (!modal) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    if (!modal || !nameField || !addressField || !phoneField || !tierLabel || !addonsLabel || !priceLabel || !result) {
      return;
    }

    const data = new FormData(form);
    const firstName = String(data.get('firstName') ?? '');
    const lastName = String(data.get('lastName') ?? '');
    const address1 = String(data.get('address1') ?? '');
    const address2 = String(data.get('address2') ?? '');
    const city = String(data.get('city') ?? '');
    const state = String(data.get('state') ?? '');
    const zip = String(data.get('zip') ?? '');
    const phone = String(data.get('phone') ?? '');

    const tierInput = form.querySelector<HTMLInputElement>('input[name="tier"]:checked');
    const addonInputs = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="addon"]:checked'));

    const tierPrice = parsePrice(tierInput?.dataset.price);
    const addonsTotal = addonInputs.reduce((sum, input) => sum + parsePrice(input.dataset.price), 0);

    nameField.textContent = `${firstName} ${lastName}`.trim() || '—';
    addressField.textContent = [address1, address2, `${city}, ${state} ${zip}`.trim()]
      .filter(Boolean)
      .join(', ');
    phoneField.textContent = phone || '—';
    tierLabel.textContent = tierInput?.value ?? '—';
    addonsLabel.textContent = addonInputs.length ? addonInputs.map((input) => input.value).join(', ') : 'None';
    priceLabel.textContent = `$${(tierPrice + addonsTotal).toFixed(2)}`;

    result.classList.add('hidden');
    result.textContent = '';
    modal.classList.remove('hidden');
    modal.classList.add('flex');
  });

  cancelBtn?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (event) => {
    if (event.target === modal) closeModal();
  });

  simulateBtn?.addEventListener('click', () => {
    if (!result) return;
    result.textContent = 'Simulated payment successful. (No real transaction occurred.)';
    result.classList.remove('hidden');
  });
</script>
