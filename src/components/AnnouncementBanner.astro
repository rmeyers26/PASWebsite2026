---
import { getCollection } from 'astro:content';

// Static build — "today" is resolved once at deploy time, the same
// tradeoff ApodOfTheDay and the ASIG calendar already accept on this site:
// accurate as of the last deploy, not live for the visitor. A Sveltia CMS
// save triggers a Netlify rebuild, so adding or removing an announcement
// takes effect immediately; one that simply reaches its End Date with no
// other site activity that day stays visible until the next rebuild.
//
// Compared as 'YYYY-MM-DD' strings in the club's home timezone (matches
// the eventSchedule timezone on /events) rather than via `new Date()`, so
// a visitor elsewhere doesn't see the banner drop a day early or late
// relative to the date an officer picked in the CMS.
const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Phoenix' }).format(new Date());

const announcement = (await getCollection('announcements'))
  .filter((entry) => entry.data.startDate <= today && entry.data.endDate >= today)
  // Only one slot on the homepage — if more than one is active at once, the
  // one that started most recently wins.
  .sort((a, b) => (a.data.startDate < b.data.startDate ? 1 : -1))
  .at(0);
---

{
  announcement && (
    <div
      role="region"
      aria-label="Announcement"
      class="border-b border-subtle bg-space-card/60 backdrop-blur-xl"
    >
      <p class="mx-auto line-clamp-5 max-w-4xl px-6 py-3 text-center text-sm text-ink-primary sm:text-base">
        {announcement.data.message}
      </p>
    </div>
  )
}
