---
import BaseLayout from '../layouts/BaseLayout.astro';

const previousBooks = [
  {
    title: 'Something Deeply Hidden: Quantum Worlds and the Emergence of Space-Time',
    author: 'Sean Carroll',
  },
  {
    title: 'Battle of the Big Bang: The New Tales of Our Cosmic Origins',
    author: 'Niayesh Afshordi and Phil Halper',
  },
  {
    title: 'The Secret Lives of Planets: Order, Chaos, and Uniqueness in the Solar System',
    author: 'Paul Murdin',
  },
  {
    title: 'The Beauty of Falling: A Life in Pursuit of Gravity',
    author: 'Claudia de Rham',
  },
];
---

<BaseLayout
  title="Astronomy Book Club"
  description="PAS BSIG: the Astronomy Book Club, exploring the best books on space, cosmology, and planetary science together."
>
  <section class="mx-auto max-w-4xl px-6 py-24 text-center">
    <span class="glass-badge mb-6">
      <span class="h-1.5 w-1.5 rounded-full bg-nebula-teal shadow-glow-teal" />
      Special Interest Group
    </span>
    <h1 class="font-display text-d2 tracking-tight text-ink-primary">
      Astronomy Book Club <span class="text-ink-muted">(BSIG)</span>
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-ink-muted">
      Love astronomy? Curious about the latest discoveries in space, cosmology, and planetary science? Join our
      Astronomy Book Club as we explore some of the most fascinating books written by leading scientists and
      science communicators.
    </p>
  </section>

  <section class="border-t border-subtle bg-space-card/40">
    <div class="mx-auto max-w-4xl px-6 py-16">
      <h2 class="section-heading">What to Expect</h2>
      <p class="mt-4 text-ink-muted">
        Each selection sparks lively discussions about our universe — from the origins of the cosmos and the
        mysteries of quantum mechanics to the evolution of planets and the forces that shape them. Whether
        you're new to astronomy or a lifelong enthusiast, you'll enjoy engaging conversations in a welcoming
        and informal setting.
      </p>
      <p class="mt-4 text-ink-muted">
        No scientific background is required — just an interest in learning and sharing ideas with fellow
        astronomy enthusiasts.
      </p>
      <p class="mt-6 text-sm text-ink-muted">
        <span aria-hidden="true">*</span> PAS membership is required to take part in BSIG — see{' '}
        <a href="/join" class="text-nebula-teal hover:underline">Join the Club</a>. For the current meeting
        schedule and location, reach out via{' '}
        <a href="/contact" class="text-nebula-teal hover:underline">Contact</a>.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-6 py-20">
    <h2 class="section-heading">Previous Book Selections</h2>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2">
      {
        previousBooks.map((book) => (
          <li class="flex items-start gap-3 rounded-lg border border-subtle bg-space-card px-5 py-4 text-ink-muted">
            <span class="mt-2 h-2 w-2 flex-none rounded-full bg-nebula-teal" aria-hidden="true" />
            <span>
              <em>{book.title}</em> — {book.author}
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="border-t border-subtle bg-space-card/40">
    <div class="mx-auto max-w-3xl px-6 py-24 text-center">
      <span class="glass-badge mb-6">
        <span class="h-1.5 w-1.5 rounded-full bg-nebula-teal shadow-glow-teal" />
        Read Together
      </span>
      <p class="font-display text-d3 tracking-tight text-ink-primary">
        Come read, learn, and discover the universe — one great book at a time.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="/join" class="btn-primary">Join the Club</a>
        <a href="/contact" class="btn-secondary">Ask About BSIG</a>
      </div>
    </div>
  </section>
</BaseLayout>
