---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';

const siteSettings = (await getEntry('site-settings', 'data'))!.data;
const lastUpdated = 'August 11, 2026';
---

<BaseLayout
  title="Privacy Policy"
  description="How the Phoenix Astronomical Society collects, uses, and protects your information."
>
  <section class="mx-auto max-w-4xl px-6 py-24">
    <span class="glass-badge mb-6">
      <span class="size-1.5 rounded-full bg-nebula-teal shadow-glow-teal"></span>
      Legal
    </span>
    <h1 class="font-display text-d2 tracking-tight text-ink-primary">Privacy Policy</h1>
    <p class="mt-4 text-sm text-ink-muted">Last updated: {lastUpdated}</p>

    <div class="mt-10 flex flex-col gap-10 text-ink-muted">
      <p>
        This website collects, saves, and forwards no personal information to the Phoenix
        Astronomical Society ("PAS," "we," "us," or "our") except in the circumstances described
        below.
      </p>

      <div>
        <h2 class="section-heading">Membership Information</h2>
        <p class="mt-4">
          When you apply for membership through our{' '}
          <a href="/join" class="text-nebula-teal hover:underline">Join</a> page, we collect the personal
          information you provide — name, mailing address, email, and phone number — to process your application
          and administer your membership. This information is retained for a period following membership
          expiration. Upon request, PAS will update and/or remove any personal information we hold about
          you.
        </p>
      </div>

      <div>
        <h2 class="section-heading">Third-Party Services</h2>
        <p class="mt-4">
          This site relies on a few external platforms to operate, each of which maintains its own
          privacy policy:
        </p>
        <ul class="mt-4 list-disc space-y-2 pl-6">
          <li>
            <strong class="text-ink-primary">Google</strong> — powers the embedded maps on our{' '}
            <a href="/events" class="text-nebula-teal hover:underline">Events</a> and{' '}
            <a href="/sky-conditions" class="text-nebula-teal hover:underline">Sky Conditions</a> pages.
            See{' '}
            <a
              href="https://policies.google.com/privacy"
              target="_blank"
              rel="noopener noreferrer"
              class="text-nebula-teal hover:underline"
            >
              Google's Privacy Policy
            </a>.
          </li>
          <li>
            <strong class="text-ink-primary">Bookwhen</strong> — handles our event calendar and registrations,
            embedded on the{' '}
            <a href="/events" class="text-nebula-teal hover:underline">Events</a> page. See{' '}
            <a
              href="https://bookwhen.com/privacy"
              target="_blank"
              rel="noopener noreferrer"
              class="text-nebula-teal hover:underline"
            >
              Bookwhen's Privacy Policy
            </a>.
          </li>
          <li>
            <strong class="text-ink-primary">PayPal</strong> — processes membership dues on the{' '}
            <a href="/join" class="text-nebula-teal hover:underline">Join</a> page. We do not collect
            or store your payment card details; PayPal handles that directly. See{' '}
            <a
              href="https://www.paypal.com/us/legalhub/privacy-full"
              target="_blank"
              rel="noopener noreferrer"
              class="text-nebula-teal hover:underline"
            >
              PayPal's Privacy Policy
            </a>.
          </li>
        </ul>
        <p class="mt-4">
          Each of these services has its own policy for retaining, updating, and/or removing
          personal information. Please consult them for details.
        </p>
      </div>

      <div>
        <h2 class="section-heading">Your Choices</h2>
        <p class="mt-4">
          You may ask us to access, correct, or delete the personal information we hold about you at
          any time by contacting us at{' '}
          <a
            href={`mailto:${siteSettings.webmasterEmail}`}
            class="text-nebula-teal hover:underline"
          >
            {siteSettings.webmasterEmail}
          </a>.
        </p>
      </div>

      <div>
        <h2 class="section-heading">Changes to This Policy</h2>
        <p class="mt-4">
          We may update this privacy policy from time to time. Changes will be posted on this page
          with an updated "Last updated" date above.
        </p>
      </div>

      <div>
        <h2 class="section-heading">Contact Us</h2>
        <p class="mt-4">
          Questions about this privacy policy or your data can be sent to{' '}
          <a
            href={`mailto:${siteSettings.webmasterEmail}`}
            class="text-nebula-teal hover:underline"
          >
            {siteSettings.webmasterEmail}
          </a>{' '}
          or{' '}
          <a href={`mailto:${siteSettings.email}`} class="text-nebula-teal hover:underline">
            {siteSettings.email}
          </a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
