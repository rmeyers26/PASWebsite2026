---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import PlaceholderNote from '../components/PlaceholderNote.astro';
import ApodOfTheDay from '../components/ApodOfTheDay.astro';

const comingSoon = [
  'Member astrophotography gallery & contest',
  'Observing Awards & PAS Academy youth challenges',
  '"Tonight in Arizona" live sky dashboard',
  'Member dashboard & event registration',
];
---

<BaseLayout
  title="Home"
  description="The Phoenix Astronomical Society is a 501(c)(3) nonprofit astronomy club serving Phoenix, Arizona since 1948."
>
  <Hero
    image="/images/placeholder-hero-home.svg"
    eyebrow="Phoenix Astronomical Society"
    title="Join Us Under Arizona's Night Sky"
    subtitle="A community of amateur and professional astronomers, teachers, and learners — of all ages and experience levels."
  >
    <div class="mt-10 flex flex-wrap justify-center gap-4">
      <a href="/events" class="btn-primary">See Upcoming Events</a>
      <a href="/join" class="btn-secondary">Become a Member</a>
    </div>
  </Hero>

  <section class="mx-auto max-w-6xl px-6 py-20">
    <div class="grid gap-8 sm:grid-cols-3">
      <div class="card">
        <h2 class="font-display text-xl text-nebula-teal">Public Star Parties</h2>
        <p class="mt-3 text-ink-muted">
          Free, open to the public, and welcoming to first-time stargazers and experienced observers alike.
        </p>
        <a href="/events" class="mt-4 inline-block text-sm font-semibold text-nebula-teal hover:underline"
          >See the schedule →</a
        >
      </div>
      <div class="card">
        <h2 class="font-display text-xl text-nebula-violet">A Club Since 1948</h2>
        <p class="mt-3 text-ink-muted">
          Nearly eight decades of bringing Arizona's skies to students, families, and lifelong astronomers.
        </p>
        <a href="/about" class="mt-4 inline-block text-sm font-semibold text-nebula-violet hover:underline"
          >Our history →</a
        >
      </div>
      <div class="card">
        <h2 class="font-display text-xl text-nebula-amber">Bring Your Class or Troop</h2>
        <p class="mt-3 text-ink-muted">
          PAS brings telescopes and presenters to schools, scout troops, and community groups.
        </p>
        <a href="/star-tours" class="mt-4 inline-block text-sm font-semibold text-nebula-amber hover:underline"
          >Request a visit →</a
        >
      </div>
    </div>
  </section>

  <ApodOfTheDay />

  <section class="border-t border-subtle bg-space-card/40">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <h2 class="section-heading">Coming Soon</h2>
      <p class="mt-3 max-w-2xl text-ink-muted">
        This is Phase 1 of a multi-phase rebuild. The site's visual identity and core information are live now —
        these member-facing features are on the way next.
      </p>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2">
        {
          comingSoon.map((item) => (
            <li class="flex items-center gap-3 rounded-lg border border-subtle bg-space-card px-5 py-4 text-ink-muted">
              <span class="h-2 w-2 flex-none rounded-full bg-nebula-teal" aria-hidden="true" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-6 py-16">
    <PlaceholderNote
      label="Homepage copy above uses placeholder framing where specific facts (exact meeting cadence, current officer names) aren't yet confirmed — see /about, /events, and /contact for details."
    />
  </section>
</BaseLayout>
