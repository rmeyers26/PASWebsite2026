---
import type { PdfArchiveListEntry } from '../lib/pdfArchive';

interface Props {
  entry: PdfArchiveListEntry;
  titleClass?: string;
}

const { entry, titleClass = 'font-semibold text-ink-primary hover:text-nebula-teal' } = Astro.props;
---

<div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
  {/* Same-origin document, so no new tab and no ↗ — this
      site reserves both for links that leave it. The file
      type and size sit in the link text so the label is
      honest about what following it does. */}
  <a href={entry.file} type="application/pdf" class={titleClass}>
    {entry.title ?? <time datetime={entry.date}>{entry.displayDate}</time>}
  </a>
  <span class="text-sm text-ink-muted">PDF{entry.size ? ` · ${entry.size}` : ''}</span>
</div>
{/* Only a second line when the link text is the headline —
    otherwise the date would be printed twice. */}
{
  entry.title && (
    <time datetime={entry.date} class="mt-1 block text-sm text-nebula-teal">
      {entry.displayDate}
    </time>
  )
}
{entry.summary && <p class="mt-2 text-ink-muted">{entry.summary}</p>}
