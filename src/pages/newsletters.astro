---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PdfArchiveList from '../components/PdfArchiveList.astro';
import PdfArchiveItem from '../components/PdfArchiveItem.astro';
import ArchiveEmptyState from '../components/ArchiveEmptyState.astro';
import { groupPdfArchiveByYear, type PdfArchiveEntry } from '../lib/pdfArchive';

// Content lives in src/content/newsletters/ (recent issues) and
// src/content/newsletter-archive/ (pre-2015 scans), split so the CMS's
// small, frequently-touched collection isn't buried under 100+ historical
// entries — both are managed via the Sveltia CMS and merged here for
// display. See src/content.config.ts for the schema.
const issueEntries = [
  ...(await getCollection('newsletters')),
  ...(await getCollection('newsletter-archive')),
];
const issues: PdfArchiveEntry[] = issueEntries.map((entry) => ({
  date: entry.data.date,
  title: entry.data.title,
  summary: entry.data.summary,
  volume: entry.data.volume,
  file: entry.data.pdf,
}));

const years = groupPdfArchiveByYear(issues, 'newsletters');
const [, latestIssues] = years[0] ?? [undefined, []];
const latest = latestIssues[0];

// The latest issue has its own section above, so the searchable/sortable
// archive excludes it — same entries the server-rendered fallback below
// already lists, just flattened with each entry's year attached so the
// client script can regroup after filtering.
const archiveEntries = years.flatMap(([year, entries], yearIndex) =>
  (yearIndex === 0 ? entries.slice(1) : entries).map((entry) => ({ ...entry, year }))
);

// Fed to the client-side search/sort script below — same data already
// computed for the SSR fallback, just serialized once instead of
// re-derived in JS. Escaped so a title/summary containing "</script>"
// can't break out of the embedding tag.
const archiveDataJson = JSON.stringify(archiveEntries).replace(/<\/script/gi, '<\\/script');

// Content lives in src/content/past-editors/past-editors.json (managed via
// the Sveltia CMS) — see src/content.config.ts for the schema.
const pastEditors = (await getEntry('past-editors', 'data'))!.data.editors;
---

<BaseLayout
  title="Newsletters"
  description="Read the Phoenix Astronomical Society's monthly newsletter and browse the historical archive of past issues."
>
  <section class="mx-auto max-w-4xl px-6 py-24 text-center">
    <span class="glass-badge mb-6">
      <span class="size-1.5 rounded-full bg-nebula-teal shadow-glow-teal"></span>
      Newsletters
    </span>
    <h1 class="font-display text-d2 tracking-tight text-ink-primary">Newsletters</h1>
    <p class="mx-auto mt-6 max-w-2xl text-ink-muted">
      The Phoenix Astronomical Society's monthly newsletter — club news, upcoming events, and member
      updates. Every issue is posted here as a PDF you can read or download, along with the full
      historical archive.
    </p>
  </section>

  {
    latest && (
      <section class="border-t border-subtle bg-space-card/40">
        <div class="mx-auto max-w-4xl px-6 py-16">
          <h2 class="section-heading">Latest Issue</h2>
          <div class="mt-6 border-b border-subtle pb-6">
            <PdfArchiveItem
              entry={latest}
              titleClass="text-xl font-semibold text-ink-primary hover:text-nebula-teal"
            />
          </div>
        </div>
      </section>
    )
  }

  <section class="border-t border-subtle">
    <div class="mx-auto max-w-4xl px-6 py-20">
      <h2 class="section-heading">Archive</h2>
      {
        years.length === 0 ? (
          <ArchiveEmptyState label="Newsletters" class="mt-6" />
        ) : (
          <>
            <script type="application/json" id="newsletter-data" set:html={archiveDataJson} />

            <div class="my-10 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
              <div class="flex-1">
                <label for="newsletter-search" class="block text-sm font-medium text-ink-primary">
                  Search
                </label>
                <input
                  type="search"
                  id="newsletter-search"
                  placeholder="Search by title or topic…"
                  class="mt-2 w-full rounded-lg border border-subtle bg-space-base px-4 py-2 text-ink-primary placeholder:text-ink-muted focus:border-nebula-teal focus:outline-none"
                />
              </div>
              <div class="sm:w-56">
                <label for="newsletter-sort" class="block text-sm font-medium text-ink-primary">
                  Sort by
                </label>
                <select
                  id="newsletter-sort"
                  class="mt-2 w-full rounded-lg border border-subtle bg-space-base px-4 py-2 text-ink-primary focus:border-nebula-teal focus:outline-none"
                >
                  <option value="newest">Newest first</option>
                  <option value="oldest">Oldest first</option>
                  <option value="title">Title (A–Z)</option>
                </select>
              </div>
            </div>

            <p id="newsletter-count" class="mb-6 text-sm text-ink-muted" aria-live="polite">
              {archiveEntries.length} issue{archiveEntries.length === 1 ? '' : 's'}
            </p>

            <p id="newsletter-empty" hidden class="text-ink-muted">
              No issues match your search.
            </p>

            <div id="newsletter-list" class="space-y-14">
              {years.map(([year, entries], yearIndex) => {
                // The latest issue already has its own section above, so skip it
                // here without hiding the rest of its year's issues.
                const listed = yearIndex === 0 ? entries.slice(1) : entries;
                return (
                  listed.length > 0 && (
                    <div>
                      <h3 class="text-lg font-semibold text-ink-primary">{year}</h3>
                      <PdfArchiveList entries={listed} />
                    </div>
                  )
                );
              })}
            </div>
          </>
        )
      }
    </div>
  </section>

  {
    pastEditors.length > 0 && (
      <section class="border-t border-subtle bg-space-card/40">
        <div class="mx-auto max-w-3xl px-6 py-16">
          <h2 class="section-heading">Newsletter Editors</h2>
          <p class="mt-4 text-ink-muted">
            PAStimes has been shaped over the years by a handful of dedicated volunteer editors.
          </p>
          <div class="mt-8 overflow-x-auto rounded-lg border border-subtle">
            <table class="w-full border-collapse text-left">
              <thead>
                <tr class="border-b border-subtle">
                  <th
                    scope="col"
                    class="px-5 py-3 text-xs font-semibold tracking-wide text-ink-muted uppercase"
                  >
                    Editor
                  </th>
                  <th
                    scope="col"
                    class="px-5 py-3 text-xs font-semibold tracking-wide text-ink-muted uppercase"
                  >
                    Years
                  </th>
                </tr>
              </thead>
              <tbody>
                {pastEditors.map((editor) => (
                  <tr
                    class:list={[
                      'border-b border-subtle last:border-b-0',
                      editor.current && 'bg-nebula-teal/5',
                    ]}
                  >
                    <td class="px-5 py-3 font-display text-ink-primary">
                      {editor.name}
                      {editor.current && (
                        <span class="ml-2 text-xs font-semibold tracking-wide text-nebula-teal uppercase">
                          Current
                        </span>
                      )}
                    </td>
                    <td class="px-5 py-3 text-sm text-ink-muted">{editor.years}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>
    )
  }

  <script>
    import { initNewsletterSearch } from '../scripts/newsletter-search';
    initNewsletterSearch();
  </script>
</BaseLayout>
