---
interface Props {
  image: string;
  alt?: string;
  eyebrow?: string;
  title: string;
  subtitle?: string;
}

const {
  image,
  alt = 'Placeholder — real member astrophotography will replace this image',
  eyebrow,
  title,
  subtitle,
} = Astro.props;
---

<section class="relative overflow-hidden border-b border-subtle">
  <img
    src={image}
    alt={alt}
    class="absolute inset-0 h-full w-full object-cover opacity-60"
    loading="eager"
  />
  <div class="absolute inset-0 bg-gradient-to-t from-space-base via-space-base/70 to-space-base/20"></div>
  <div class="relative mx-auto max-w-4xl px-6 py-32 text-center sm:py-40">
    {eyebrow && (
      <span class="glass-badge mb-6">
        <span class="h-1.5 w-1.5 rounded-full bg-nebula-teal" />
        {eyebrow}
      </span>
    )}
    <h1 class="font-display text-4xl leading-[1.05] font-semibold tracking-tight text-ink-primary sm:text-7xl">
      {title}
    </h1>
    {subtitle && <p class="mx-auto mt-7 max-w-2xl text-lg leading-relaxed text-ink-muted">{subtitle}</p>}
    <slot />
  </div>
</section>
