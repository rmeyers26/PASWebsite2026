---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FeatureSplit from '../components/FeatureSplit.astro';
import heroPhoto from '../assets/images/star-tours-eaa-day.jpg';
import visualChild from '../assets/images/star-tours-visual-child.jpg';

// The individual pieces below (Kids Corner, the resource links, telescope
// workshops) already existed as good, disconnected content — this sequence
// adds no new writing, just an order. Each step reuses a page or link that's
// already live elsewhere on the site.
const startHerePath = [
  {
    title: 'Learn the Sky Tonight',
    body: "Open our interactive sky chart and see exactly what's overhead right now from Phoenix — no download, no account.",
    href: '/sky-conditions#skychart',
    cta: 'Open the Sky Chart',
    accent: 'text-nebula-teal',
  },
  {
    title: 'Come to a Public Star Party',
    body: 'Free, no telescope or experience required. Look through a real eyepiece and let a member walk you across the sky.',
    href: '/events',
    cta: 'Find the Next One',
    accent: 'text-nebula-violet',
  },
  {
    title: 'Get Hands-On Help With a Telescope',
    body: "Own a scope you can't figure out, or need help picking one? PAS runs free telescope workshops throughout the year.",
    href: '/telescope-workshops',
    cta: 'See Workshops',
    accent: 'text-nebula-amber',
  },
  {
    title: 'Join PAS',
    body: "Ready for more? Membership gets you the newsletter, the telescope loaner program, and a community that won't tire of your questions.",
    href: '/join',
    cta: 'Become a Member',
    accent: 'text-nebula-teal',
  },
];

const kidsResources = [
  {
    name: 'NASA Space Place',
    url: 'https://spaceplace.nasa.gov/',
    body: "NASA's site built for elementary-age kids — games, hands-on craft activities, and plain-language answers about planets, stars, and space technology.",
  },
  {
    name: "NASA Kids' Club",
    url: 'https://www.nasa.gov/learning-resources/nasa-kids-club/',
    body: 'Games and activities for younger kids straight from NASA, covering rockets, astronauts, and life in space.',
  },
  {
    name: 'NASA Learning Resources',
    url: 'https://www.nasa.gov/learning-resources/',
    body: "NASA's full hub of lessons, activities, and materials for students and families, organized by grade level and topic.",
  },
  {
    name: 'ESA Kids',
    url: 'https://www.esa.int/kids/en/home',
    body: "The European Space Agency's children's site, with stories and activities about the solar system, the universe, and life as an astronaut.",
  },
  {
    name: 'Interactive Sky Chart',
    url: '/sky-conditions#skychart',
    body: 'See exactly what is overhead tonight from Phoenix with our interactive sky chart, right here on the PAS site — no download, no account.',
    internal: true,
  },
  {
    name: "NASA's Eyes on the Solar System",
    url: 'https://eyes.nasa.gov/apps/solar-system/#/home',
    body: 'A free, real-time 3D model of the solar system, built by NASA/JPL from actual mission data — fly through it, fast-forward or rewind time, and see why a planet is or is not visible tonight.',
  },
];

// Content lives in src/content/career-faqs/career-faqs.json (managed via the
// Sveltia CMS) — see src/content.config.ts for the schema.
const careerFaqEntry = (await getEntry('career-faqs', 'data'))!;
const careerFaqs = careerFaqEntry.data.faqs;

// Same question/answer pairs rendered below as the visible FAQ — mapped into
// schema.org's FAQPage shape so the section is eligible for Google's FAQ rich
// result instead of being just styled HTML. See events.astro for the same
// JSON-LD pattern applied to Event markup.
const careerFaqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: careerFaqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};

const resourceGroups = [
  {
    title: 'Plan Your Observing',
    accent: 'text-nebula-teal',
    links: [
      {
        name: 'Stellarium',
        url: 'https://stellarium.org/',
        note: 'Free desktop planetarium software',
      },
      {
        name: 'Heavens-Above',
        url: 'https://heavens-above.com/',
        note: 'Satellite passes and ISS predictions',
      },
      {
        name: 'Sky Conditions & Observing Sites',
        url: '/sky-conditions',
        note: 'Our Phoenix-area forecast and dark-sky site list',
        internal: true,
      },
    ],
  },
  {
    title: 'News & Magazines',
    accent: 'text-nebula-violet',
    links: [
      {
        name: 'Sky & Telescope',
        url: 'https://skyandtelescope.org/',
        note: 'Observing guides and monthly sky highlights',
      },
      {
        name: 'Astronomy Magazine',
        url: 'https://www.astronomy.com/',
        note: 'News, equipment reviews, and beginner guides',
      },
      {
        name: 'EarthSky',
        url: 'https://earthsky.org/',
        note: 'Daily "what to look for tonight" posts',
      },
    ],
  },
  {
    title: 'Organizations',
    accent: 'text-nebula-amber',
    links: [
      {
        name: 'Astronomical League',
        url: 'https://www.astroleague.org/',
        note: 'Structured observing programs and awards',
      },
      {
        name: 'DarkSky International',
        url: 'https://darksky.org/',
        note: 'Light pollution advocacy and resources',
      },
      {
        name: 'AAVSO',
        url: 'https://www.aavso.org/',
        note: 'Variable star observing for amateurs',
      },
    ],
  },
  {
    title: 'Space Agencies & Imagery',
    accent: 'text-nebula-teal',
    links: [
      { name: 'NASA', url: 'https://www.nasa.gov/', note: 'Missions, news, and image libraries' },
      {
        name: 'Astronomy Picture of the Day',
        url: 'https://apod.nasa.gov/apod/astropix.html',
        note: 'A new astronomical image daily since 1995',
      },
      {
        name: 'European Space Agency',
        url: 'https://www.esa.int/',
        note: "Europe's missions and science results",
      },
    ],
  },
  {
    title: 'Contribute to Real Science',
    accent: 'text-nebula-violet',
    links: [
      {
        name: 'Zooniverse',
        url: 'https://www.zooniverse.org/',
        note: 'Citizen science projects, including galaxy classification',
      },
      {
        name: 'NASA Citizen Science',
        url: 'https://science.nasa.gov/citizen-science/',
        note: 'Official NASA-affiliated volunteer projects',
      },
    ],
  },
];

const careerLinks = [
  { name: 'American Astronomical Society — Careers', url: 'https://aas.org/careers' },
  { name: 'NASA — Careers', url: 'https://www.nasa.gov/careers/' },
];
---

<BaseLayout
  title="Learn Astronomy"
  description="Beginner-friendly astronomy resources from the Phoenix Astronomical Society — a kids' corner, answers about astronomy careers, and a curated set of links for observers of every level."
>
  <script type="application/ld+json" set:html={JSON.stringify(careerFaqSchema)} />
  <Hero
    image={heroPhoto}
    alt="A PAS member showing visitors a telescope setup at a daytime outreach event"
    eyebrow="Learn Astronomy"
    title="Start Exploring the Sky"
    subtitle="Whether you're eight years old, weighing a career in astrophysics, or just looking for a good star chart — here's where to begin."
    focalPoint="30% 15%"
  />

  <section id="start-here" class="mx-auto max-w-6xl scroll-mt-24 px-6 py-20">
    <h2 class="section-heading">Start Here</h2>
    <p class="mt-4 max-w-2xl text-ink-muted">
      Four steps from "curious" to "part of the club" — in order, though nothing stops you from
      skipping ahead.
    </p>
    <ol class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        startHerePath.map((step, index) => (
          <li class="card flex flex-col">
            <span class={`font-display text-3xl ${step.accent}`} aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-4 font-display text-lg text-ink-primary">{step.title}</h3>
            <p class="mt-3 flex-1 text-sm text-ink-muted">{step.body}</p>
            <a href={step.href} class="mt-5 text-sm font-semibold text-nebula-teal hover:underline">
              {step.cta} <span aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="mx-auto max-w-5xl border-t border-subtle px-6 py-20">
    <h2 class="section-heading">Kids Corner</h2>
    <p class="mt-4 max-w-2xl text-ink-muted">
      Astronomy is one of the few sciences where a curious kid and a professional researcher can
      look at the same sky on the same night. These are good places for young astronomers to start.
    </p>
    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {
        kidsResources.map((resource) => (
          <a
            href={resource.url}
            class="card block"
            {...(resource.internal ? {} : { target: '_blank', rel: 'noopener noreferrer' })}
          >
            <h3 class="font-display text-lg text-nebula-teal">
              {resource.name} {!resource.internal && <span aria-hidden="true">↗</span>}
            </h3>
            <p class="mt-3 text-ink-muted">{resource.body}</p>
          </a>
        ))
      }
    </div>
    <p class="mt-8 text-ink-muted">
      Kids are welcome at every PAS public star party, and looking through a real telescope beats
      any website. See <a href="/events" class="text-nebula-teal hover:underline">upcoming events</a
      > to find the next one.
    </p>
  </section>

  <section class="border-t border-subtle bg-space-card/40">
    <div class="mx-auto max-w-4xl px-6 py-20">
      <h2 class="section-heading">FAQ: Astronomy Careers</h2>
      <p class="mt-4 max-w-2xl text-ink-muted">
        Questions we hear from students and parents at outreach events, answered generally — a
        professional astronomer or a school counselor can give you advice specific to your
        situation.
      </p>
      <dl class="mt-10 space-y-8">
        {
          careerFaqs.map((faq) => (
            <div>
              <dt class="font-display text-lg text-nebula-teal">{faq.question}</dt>
              <dd class="mt-3 text-ink-muted">{faq.answer}</dd>
            </div>
          ))
        }
      </dl>
      <div class="mt-10">
        <h3 class="font-display text-lg text-ink-primary">Where to read more</h3>
        <ul class="mt-4 space-y-2">
          {
            careerLinks.map((link) => (
              <li>
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-nebula-teal hover:underline"
                >
                  {link.name} <span aria-hidden="true">↗</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 py-20">
    <h2 class="section-heading">Astronomy Resources</h2>
    <p class="mt-4 max-w-2xl text-ink-muted">
      Sites PAS members actually use — for planning a night out, keeping up with the field, and
      going deeper.
    </p>
    <div class="mt-10 space-y-10">
      {
        resourceGroups.map((group) => (
          <div>
            <h3 class={`font-display text-xl tracking-wide ${group.accent}`}>{group.title}</h3>
            <ul class="mt-4 space-y-3">
              {group.links.map((link) => (
                <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b border-subtle pb-3">
                  <a
                    href={link.url}
                    class="font-semibold text-ink-primary hover:text-nebula-teal"
                    {...(link.internal ? {} : { target: '_blank', rel: 'noopener noreferrer' })}
                  >
                    {link.name}
                    {!link.internal && <span aria-hidden="true"> ↗</span>}
                  </a>
                  <span class="text-sm text-ink-muted">{link.note}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <FeatureSplit
    image={visualChild}
    alt="A young child looking through a telescope eyepiece in her front yard"
    eyebrow="Beyond the Screen"
    title="Learn Alongside Other Observers"
  >
    <p>
      Reading about the sky is a good start; sharing an eyepiece with someone who knows it well is
      better. PAS runs free telescope workshops and public star parties throughout the year.
    </p>
    <div class="flex flex-wrap gap-4 pt-2">
      <a href="/telescope-workshops" class="btn-primary">Telescope Workshops</a>
      <a href="/events" class="btn-secondary">Upcoming Events</a>
    </div>
  </FeatureSplit>

  <section class="mx-auto max-w-4xl px-6 py-16">
    <p class="text-sm text-ink-muted">
      External resources on this page are third-party sites chosen as generally recognized starting
      points, not PAS endorsements, and the careers answers are general guidance rather than
      club-authored advice.
    </p>
  </section>
</BaseLayout>
