---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';

const siteSettings = (await getEntry('site-settings', 'data'))!.data;
const lastUpdated = 'August 11, 2026';
---

<BaseLayout
  title="Privacy Policy"
  description="How the Phoenix Astronomical Society collects, uses, and protects your information."
>
  <section class="mx-auto max-w-4xl px-6 py-24">
    <span class="glass-badge mb-6">
      <span class="h-1.5 w-1.5 rounded-full bg-nebula-teal shadow-glow-teal" />
      Legal
    </span>
    <h1 class="font-display text-d2 tracking-tight text-ink-primary">Privacy Policy</h1>
    <p class="mt-4 text-sm text-ink-muted">Last updated: {lastUpdated}</p>

    <div class="mt-10 flex flex-col gap-10 text-ink-muted">
      <p>
        The Phoenix Astronomical Society ("PAS," "we," "us," or "our") respects your privacy. This policy explains
        what information we collect through {siteSettings.orgName}'s website, how we use it, and the choices you
        have. By using this site, you agree to the practices described below.
      </p>

      <div>
        <h2 class="section-heading">Information We Collect</h2>
        <p class="mt-4">We collect information in a few limited ways:</p>
        <ul class="mt-4 list-disc space-y-2 pl-6">
          <li>
            <strong class="text-ink-primary">Information you provide directly</strong> — such as your name, mailing
            address, email, and phone number when you join as a member, sign up for events, or contact us via
            email or a form on this site.
          </li>
          <li>
            <strong class="text-ink-primary">Event registrations</strong> — public star party and event bookings
            are handled through Bookwhen, a third-party scheduling service embedded on our{' '}
            <a href="/events" class="text-nebula-teal hover:underline">Events</a> page. Information you submit there
            is subject to{' '}
            <a
              href="https://bookwhen.com/privacy"
              target="_blank"
              rel="noopener noreferrer"
              class="text-nebula-teal hover:underline"
            >
              Bookwhen's own privacy policy
            </a>.
          </li>
          <li>
            <strong class="text-ink-primary">Membership payments</strong> — membership dues are processed by
            PayPal. We do not collect or store your full payment card details; that information is handled directly
            by PayPal under{' '}
            <a
              href="https://www.paypal.com/us/legalhub/privacy-full"
              target="_blank"
              rel="noopener noreferrer"
              class="text-nebula-teal hover:underline"
            >
              PayPal's privacy policy
            </a>.
          </li>
          <li>
            <strong class="text-ink-primary">Analytics</strong> — we use{' '}
            <a
              href="https://plausible.io/data-policy"
              target="_blank"
              rel="noopener noreferrer"
              class="text-nebula-teal hover:underline"
            >
              Plausible Analytics
            </a>, a privacy-focused, cookieless analytics tool. It does not use cookies or track you across sites,
            and does not collect any personally identifiable information — only aggregate statistics like page
            views and referral sources.
          </li>
          <li>
            <strong class="text-ink-primary">Embedded content</strong> — pages that include a Google Maps or YouTube
            embed may cause those third-party services to collect data according to their own privacy policies once
            the embed loads.
          </li>
        </ul>
      </div>

      <div>
        <h2 class="section-heading">How We Use Your Information</h2>
        <p class="mt-4">We use the information we collect to:</p>
        <ul class="mt-4 list-disc space-y-2 pl-6">
          <li>Process membership applications and renewals</li>
          <li>Respond to inquiries sent to our contact addresses</li>
          <li>Send club communications, such as our monthly newsletter, to members who have requested them</li>
          <li>Coordinate school and scout star tour requests</li>
          <li>Understand overall site traffic so we can improve the website</li>
        </ul>
        <p class="mt-4">
          We do not sell, rent, or trade your personal information to third parties for marketing purposes.
        </p>
      </div>

      <div>
        <h2 class="section-heading">Cookies</h2>
        <p class="mt-4">
          This site does not use tracking or advertising cookies. Our analytics provider, Plausible, is cookieless
          by design. Third-party embeds (such as Bookwhen or Google Maps) may set their own cookies when loaded;
          please refer to their respective privacy policies for details.
        </p>
      </div>

      <div>
        <h2 class="section-heading">Data Sharing</h2>
        <p class="mt-4">
          We share information only with the service providers necessary to operate the site and run the
          organization — for example, Bookwhen (event registration) and PayPal (membership payment processing) —
          and only to the extent needed for those services to function. We do not share your information with
          third parties for their own marketing purposes.
        </p>
      </div>

      <div>
        <h2 class="section-heading">Data Retention</h2>
        <p class="mt-4">
          We retain member and contact information for as long as reasonably necessary to maintain your
          membership, respond to your inquiry, or comply with our recordkeeping and legal obligations as a
          501(c)(3) nonprofit organization.
        </p>
      </div>

      <div>
        <h2 class="section-heading">Your Choices</h2>
        <p class="mt-4">
          You may ask us to access, correct, or delete the personal information we hold about you, or to
          unsubscribe from newsletter emails, at any time by contacting us at{' '}
          <a href={`mailto:${siteSettings.webmasterEmail}`} class="text-nebula-teal hover:underline">
            {siteSettings.webmasterEmail}
          </a>.
        </p>
      </div>

      <div>
        <h2 class="section-heading">Children's Privacy</h2>
        <p class="mt-4">
          Our school and scout star tour programs may involve minors, but any information collected for those
          programs (such as a school contact's details) is provided by a supervising adult, not the children
          themselves. We do not knowingly collect personal information directly from children online.
        </p>
      </div>

      <div>
        <h2 class="section-heading">Changes to This Policy</h2>
        <p class="mt-4">
          We may update this privacy policy from time to time. Changes will be posted on this page with an updated
          "Last updated" date above.
        </p>
      </div>

      <div>
        <h2 class="section-heading">Contact Us</h2>
        <p class="mt-4">
          Questions about this privacy policy or your data can be sent to{' '}
          <a href={`mailto:${siteSettings.webmasterEmail}`} class="text-nebula-teal hover:underline">
            {siteSettings.webmasterEmail}
          </a>{' '}
          or{' '}
          <a href={`mailto:${siteSettings.email}`} class="text-nebula-teal hover:underline">
            {siteSettings.email}
          </a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
