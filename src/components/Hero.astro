---
import { Image } from 'astro:assets';

interface Props {
  image: ImageMetadata | string;
  alt?: string;
  eyebrow?: string;
  title: string;
  subtitle?: string;
}

const {
  image,
  alt = 'Placeholder — real member astrophotography will replace this image',
  eyebrow,
  title,
  subtitle,
} = Astro.props;
---

<section data-hero class="relative overflow-hidden border-b border-subtle">
  {typeof image === 'string' ? (
    <img
      src={image}
      alt={alt}
      class="absolute inset-0 h-full w-full object-cover opacity-60"
      loading="eager"
    />
  ) : (
    <Image
      src={image}
      alt={alt}
      widths={[640, 1024, 1440]}
      sizes="100vw"
      quality={52}
      class="absolute inset-0 h-full w-full object-cover opacity-60"
      loading="eager"
      fetchpriority="high"
    />
  )}
  <div class="absolute inset-0 bg-gradient-to-t from-space-base via-space-base/70 to-space-base/20"></div>
  <div class="relative mx-auto max-w-4xl px-6 py-32 text-center sm:py-40">
    {eyebrow && (
      <span class="glass-badge mb-6">
        <span class="h-1.5 w-1.5 rounded-full bg-nebula-teal shadow-glow-teal" />
        {eyebrow}
      </span>
    )}
    <!-- Solid ink, not .text-gradient: this hero sits over photography, where the
         gradient's violet midpoint lands on unpredictable local backgrounds. -->
    <h1 class="font-display text-d1 leading-[1.05] tracking-tight text-ink-primary">{title}</h1>
    {subtitle && <p class="mx-auto mt-7 max-w-2xl text-lg leading-relaxed text-ink-muted">{subtitle}</p>}
    <slot />
  </div>
</section>
