---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';

const detectionMethods = [
  {
    name: 'Transit Method',
    description:
      "Watching a star's brightness for the tiny, periodic dip caused by a planet passing in front of it. This is how NASA's Kepler and TESS missions have found most known exoplanets.",
  },
  {
    name: 'Radial Velocity',
    description:
      "Measuring the slight wobble in a star's motion caused by the gravitational tug of an orbiting planet, detected as a shift in the star's spectral lines.",
  },
  {
    name: 'Direct Imaging',
    description:
      'Capturing an actual image of a planet by blocking out the overwhelming glare of its host star — challenging, but increasingly possible for large planets far from their star.',
  },
  {
    name: 'Gravitational Microlensing',
    description:
      "Detecting a brief brightening of a distant star's light as its gravity — and that of any orbiting planet — bends and focuses light from a background star passing behind it.",
  },
];

const planetTypes = [
  {
    name: 'Gas Giants',
    description: 'Jupiter- and Saturn-size worlds of hydrogen and helium, including "hot Jupiters" orbiting scorchingly close to their stars.',
  },
  {
    name: 'Neptunian',
    description: 'Neptune- and Uranus-size planets with hydrogen- and helium-rich atmospheres surrounding icy or rocky cores.',
  },
  {
    name: 'Super-Earths',
    description: 'Rocky or gaseous worlds more massive than Earth but lighter than Neptune, with no equivalent in our own solar system.',
  },
  {
    name: 'Terrestrial',
    description: "Earth-size, rocky worlds — the type of planet most likely to be habitable, and a key target in the search for life beyond Earth.",
  },
];
---

<BaseLayout
  title="Exoplanets"
  description="An introduction to exoplanets — worlds beyond our solar system — how astronomers find them, and how PAS members observe exoplanet-hosting stars."
>
  <Hero
    image="/images/placeholder-hero-exoplanets.svg"
    eyebrow="Worlds Beyond Our Solar System"
    title="Exoplanets"
    subtitle="Thousands of planets have been confirmed orbiting other stars — and astronomers are still finding more."
  />

  <section class="mx-auto max-w-4xl px-6 py-20">
    <h2 class="section-heading">What Is an Exoplanet?</h2>
    <p class="mt-4 text-ink-muted">
      An exoplanet is any planet beyond our own solar system, orbiting a star other than the Sun. Most are far too
      distant and too faint to see directly next to the glare of their host star, so astronomers infer their
      existence using indirect methods — watching for the subtle effects a planet has on the star it orbits.
    </p>
    <p class="mt-4 text-ink-muted">
      Since the first confirmed detection in 1992, astronomers have confirmed thousands of exoplanets, with many
      more candidates awaiting confirmation. They come in a huge range of sizes and compositions — some larger
      than Jupiter, some smaller than Earth, and some orbiting in the "habitable zone" where liquid water could
      exist on a rocky surface.
    </p>
    <a
      href="https://science.nasa.gov/exoplanets/"
      target="_blank"
      rel="noopener noreferrer"
      class="btn-secondary mt-6"
    >
      Explore NASA's Exoplanet Site
    </a>
  </section>

  <section class="border-t border-subtle bg-space-card/40">
    <div class="mx-auto max-w-4xl px-6 py-20">
      <h2 class="section-heading">How We Find Them</h2>
      <p class="mt-4 max-w-2xl text-ink-muted">
        Exoplanets are found using several complementary techniques, each suited to different kinds of planets and
        stars.
      </p>
      <div class="mt-8 grid gap-6 sm:grid-cols-2">
        {
          detectionMethods.map((method) => (
            <div class="card">
              <h3 class="font-display text-lg text-nebula-teal">{method.name}</h3>
              <p class="mt-2 text-sm text-ink-muted">{method.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-6 py-20">
    <h2 class="section-heading">Kinds of Exoplanets</h2>
    <p class="mt-4 max-w-2xl text-ink-muted">
      Exoplanets discovered so far fall into a few broad categories, many with no direct counterpart in our own
      solar system.
    </p>
    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      {
        planetTypes.map((type) => (
          <div class="card">
            <h3 class="font-display text-lg text-nebula-violet">{type.name}</h3>
            <p class="mt-2 text-sm text-ink-muted">{type.description}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="border-t border-subtle bg-space-card/40">
    <div class="mx-auto max-w-4xl px-6 py-20">
      <h2 class="section-heading">Missions Leading the Search</h2>
      <p class="mt-4 text-ink-muted">
        NASA's <strong class="text-ink-primary">Kepler</strong> space telescope revealed that planets are
        common throughout the galaxy, discovering thousands of candidates during its mission. Its successor,
        the <strong class="text-ink-primary">Transiting Exoplanet Survey Satellite (TESS)</strong>, is
        surveying the whole sky for planets around nearby, bright stars. The
        <strong class="text-ink-primary">James Webb Space Telescope</strong> is now studying the atmospheres of
        known exoplanets in unprecedented detail, searching for water, methane, and other molecules that could
        hint at habitability — or even life.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-6 py-20">
    <h2 class="section-heading">Exoplanet Hunting from Your Backyard</h2>
    <p class="mt-4 text-ink-muted">
      You don't need a space telescope to be part of exoplanet science. Amateur astronomers with modest
      telescopes and CCD or CMOS cameras can record transit light curves of known exoplanet-hosting stars,
      contributing real data to projects like the
      <a
        href="https://exoplanets.nasa.gov/exoplanet-watch/about-exoplanet-watch/overview/"
        target="_blank"
        rel="noopener noreferrer"
        class="text-nebula-teal hover:underline"
      >
        NASA Exoplanet Watch
      </a>
      citizen science program. PAS members interested in exoplanet observing are welcome to connect with fellow
      members at our public star parties and meetings.
    </p>
    <a href="/events" class="btn-secondary mt-6">See Upcoming PAS Events</a>
  </section>
</BaseLayout>
