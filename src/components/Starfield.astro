---
// Soft daylight atmosphere: ambient, slowly-drifting color blooms over the
// light surface, replacing the prior dark-sky starfield.
---

<div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden bg-space-base" aria-hidden="true">
  <div class="ambient-orb ambient-orb-teal absolute -left-[10%] -top-[15%] h-[50vw] w-[50vw] max-w-[720px] rounded-full bg-nebula-teal/10 blur-[120px]"></div>
  <div class="ambient-orb ambient-orb-amber absolute -right-[15%] top-[10%] h-[45vw] w-[45vw] max-w-[640px] rounded-full bg-nebula-amber/10 blur-[120px]"></div>
  <div class="ambient-orb ambient-orb-violet absolute bottom-[-10%] left-[20%] h-[40vw] w-[40vw] max-w-[560px] rounded-full bg-nebula-violet/10 blur-[120px]"></div>
</div>

<style>
  .ambient-orb {
    animation: ambient-drift 40s ease-in-out infinite;
  }

  .ambient-orb-amber {
    animation-duration: 50s;
    animation-direction: reverse;
  }

  .ambient-orb-violet {
    animation-duration: 60s;
  }

  @keyframes ambient-drift {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(4%, 6%) scale(1.08);
    }
  }
</style>
