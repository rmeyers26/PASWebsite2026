---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

// Content lives in src/content/past-presidents/past-presidents.json (managed
// via the Sveltia CMS) — see src/content.config.ts for the schema.
const pastPresidents = (await getEntry('past-presidents', 'data'))!;
const poaPresidents = pastPresidents.data.presidents.filter((p) => p.org === 'POA');
const pasPresidents = pastPresidents.data.presidents.filter((p) => p.org === 'PAS');
---

<BaseLayout
  title="Past Presidents"
  description="A list of every president to lead the Phoenix Observatory Association and Phoenix Astronomical Society since 1948."
>
  <section class="mx-auto max-w-4xl px-6 py-24 text-center">
    <span class="glass-badge mb-6">
      <span class="h-1.5 w-1.5 rounded-full bg-nebula-teal shadow-glow-teal" />
      Club Leadership
    </span>
    <h1 class="font-display text-d2 tracking-tight text-ink-primary">Past Presidents</h1>
    <p class="mx-auto mt-6 max-w-2xl text-ink-muted">
      PAS is run entirely by volunteer members, including officers overseeing membership, events, and community
      outreach. Stu Brackney is our current president.
    </p>
  </section>

  <section class="border-t border-subtle bg-space-card/40">
    <div class="mx-auto max-w-3xl px-6 py-16">
      <h2 class="section-heading">Phoenix Observatory Association</h2>
      <div class="mt-8 overflow-x-auto rounded-lg border border-subtle">
        <table class="w-full border-collapse text-left">
          <thead>
            <tr class="border-b border-subtle">
              <th scope="col" class="px-5 py-3 text-xs font-semibold uppercase tracking-wide text-ink-muted">
                President
              </th>
              <th scope="col" class="px-5 py-3 text-xs font-semibold uppercase tracking-wide text-ink-muted">
                Years
              </th>
            </tr>
          </thead>
          <tbody>
            {
              poaPresidents.map((president) => (
                <tr class="border-b border-subtle last:border-b-0">
                  <td class="px-5 py-3 font-display text-ink-primary">{president.name}</td>
                  <td class="px-5 py-3 text-sm text-ink-muted">{president.years}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="border-t border-subtle">
    <div class="mx-auto max-w-3xl px-6 py-16">
      <h2 class="section-heading">Phoenix Astronomical Society</h2>
      <div class="mt-8 overflow-x-auto rounded-lg border border-subtle">
        <table class="w-full border-collapse text-left">
          <thead>
            <tr class="border-b border-subtle">
              <th scope="col" class="px-5 py-3 text-xs font-semibold uppercase tracking-wide text-ink-muted">
                President
              </th>
              <th scope="col" class="px-5 py-3 text-xs font-semibold uppercase tracking-wide text-ink-muted">
                Years
              </th>
            </tr>
          </thead>
          <tbody>
            {
              pasPresidents.map((president) => (
                <tr
                  class:list={[
                    'border-b border-subtle last:border-b-0',
                    president.current && 'bg-nebula-teal/5',
                  ]}
                >
                  <td class="px-5 py-3 font-display text-ink-primary">
                    {president.name}
                    {president.current && (
                      <span class="ml-2 text-xs font-semibold uppercase tracking-wide text-nebula-teal">
                        Current
                      </span>
                    )}
                  </td>
                  <td class="px-5 py-3 text-sm text-ink-muted">{president.years}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mt-8 text-sm text-ink-muted">Presidents assume office in May of the listed year(s).</p>
    </div>
  </section>

  <section class="border-t border-subtle bg-space-card/40">
    <div class="mx-auto max-w-3xl px-6 py-16 text-center">
      <a href="/about" class="btn-secondary">← Back to About</a>
    </div>
  </section>
</BaseLayout>
