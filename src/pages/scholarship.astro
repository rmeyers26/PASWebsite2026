---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { getEntry } from 'astro:content';
import heroPhoto from '../assets/images/about-officer-award-telescope.jpg';

const siteSettings = (await getEntry('site-settings', 'data'))!.data;

const highlights = [
  {
    title: 'Who it helps',
    body: 'Students attending Paradise Valley Community College who are studying astronomy or a related field.',
  },
  {
    title: 'In honor of',
    body: 'Named for Sam Insana, a former PAS President, and established by the Society in August 2022 to carry on his legacy of astronomy education.',
  },
  {
    title: 'Your contribution',
    body: 'PAS is a 501(c)(3) nonprofit organization, so your gift is tax-deductible and you will receive a receipt for your records.',
  },
];
---

<BaseLayout
  title="Sam Insana Scholarship Fund"
  description="Contribute to the PAS Sam Insana Scholarship Fund, awarding scholarships to Paradise Valley Community College students studying astronomy and related fields."
>
  <Hero
    image={heroPhoto}
    alt="A PAS officer presenting an award beside a telescope"
    eyebrow="Give Back"
    title="PAS Sam Insana Scholarship Fund"
    subtitle="Help students learning about our night skies by contributing to the PAS Sam Insana Scholarship Fund."
    tone="dark"
  />

  <section class="mx-auto max-w-4xl px-6 py-20">
    <h2 class="section-heading">About the Fund</h2>
    <p class="mt-4 text-ink-muted">
      The PAS Sam Insana Scholarship Fund awards scholarships to students attending Paradise Valley
      Community College who are studying astronomy and/or related fields. Contributions to the fund
      go directly toward supporting the next generation of astronomers in our community.
    </p>

    <div class="mt-10 grid gap-4 sm:grid-cols-3">
      {
        highlights.map((item) => (
          <div class="card">
            <p class="font-display text-ink-primary">{item.title}</p>
            <p class="mt-2 text-sm text-ink-muted">{item.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="border-t border-subtle bg-space-card/40">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="section-heading">Make a Contribution</h2>
      <p class="mx-auto mt-4 max-w-xl text-ink-muted">
        To contribute to the Sam Insana Scholarship Fund, reach out to us at{' '}
        <a href={`mailto:${siteSettings.email}`} class="text-nebula-teal hover:underline">
          {siteSettings.email}
        </a>
        . As a 501(c)(3) non-profit organization, we'll send you a receipt for your contribution.
      </p>
      <a href={`mailto:${siteSettings.email}?subject=Sam Insana Scholarship Fund Contribution`} class="btn-primary mt-8">
        Email {siteSettings.email}
      </a>
    </div>
  </section>
</BaseLayout>
