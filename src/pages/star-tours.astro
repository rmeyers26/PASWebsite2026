---
import BaseLayout from '../layouts/BaseLayout.astro';

const visualPoints = [
  'A telescope fitted with an eyepiece, letting each guest observe the target individually.',
  'The operator sets up an hour early, then acquires, focuses, and tracks targets throughout the event.',
  'The operator educates guests on what they’re looking at, and answers astronomy questions in the queue.',
  'Popular targets include the moon, planets in our solar system, star clusters, asterisms, bright reflection and emission nebulae, and large galaxies.',
  'Each visual telescope can entertain and educate up to 30 guests with limited wait times.',
  'Typical events view 5–6 targets depending on guest count, light pollution, clouds, and time of year — smaller groups may see up to 15.',
];

const eaaPoints = [
  'A high-resolution astronomy camera presents the telescope’s live view on a large monitor, so a whole group can watch together.',
  'The operator sets up an hour early, then acquires, focuses, and tracks targets throughout the event.',
  'The operator educates viewers on what they’re looking at, and answers astronomy questions.',
  'Popular targets include the moon, planets in our solar system, star clusters, colorful nebulae, and galaxies — with visible detail like spiral arms.',
  'Each EAA telescope may handle up to 40 guests, seated or standing in front of the monitor.',
  'Typical events include views of 12–15 targets.',
];

const presentations = [
  'Meteorite collection presentation',
  'Traveling the universe by telescope',
  'How to understand the night sky',
  'The mathematics of cosmological distances',
  'The history of our universe',
];

const bookingInfo = [
  'Event sponsor',
  'Name of event',
  'Brief description of the event',
  'Date',
  'Times (start & end)',
  'Location address',
  'Number of telescopes (operators) desired',
  'Additional presenters (e.g. meteorites) desired',
  "Contact's name, email, and telephone",
];

const samplePhotos = [
  { src: '/images/star-tours-sample-helix-nebula.jpg', alt: 'The Helix Nebula, a colorful planetary nebula', caption: 'The Helix Nebula' },
  { src: '/images/star-tours-sample-whirlpool-galaxy.jpg', alt: 'The Whirlpool Galaxy, a spiral galaxy with a companion galaxy', caption: 'The Whirlpool Galaxy' },
  { src: '/images/star-tours-sample-comet.jpg', alt: 'A green comet with a long tail against a starfield', caption: 'A comet, tail streaming' },
];
---

<BaseLayout
  title="Star Tours"
  description="Book a PAS Star Tours event: telescopes, presenters, and hands-on astronomy for schools, scout troops, businesses, and celebrations."
>
  <section class="relative overflow-hidden border-b border-subtle">
    <img
      src="/images/star-tours-eaa-night.jpg"
      alt="A PAS EAA telescope setup at night under red light, with the Triangulum Galaxy displayed on the monitor and the Phoenix skyline behind"
      class="absolute inset-0 h-full w-full object-cover opacity-60"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-space-base via-space-base/70 to-transparent"></div>
    <div class="relative mx-auto max-w-4xl px-6 py-28 text-center sm:py-36">
      <p class="mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-nebula-teal">Star Tours</p>
      <h1 class="font-display text-4xl leading-tight tracking-wide text-ink-primary sm:text-6xl">
        What Can Star Tours Do for You?
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-ink-muted">
        PAS performs community outreach for public and private groups alike — star parties, educational events,
        celebrations, and corporate events — brought to you by amateur astronomers with excellent telescope
        operation and presentation skills.
      </p>
      <a href="mailto:startours@pasaz.org" class="btn-primary mt-10 inline-flex">Book an Event</a>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-6 py-20">
    <p class="text-ink-muted">
      These events are offered for a fee based on the type of event, the number of operators/presenters, and the
      duration of the event. A standardized Star Tours event is two hours, but longer events are welcomed. Our
      team provides their own telescopes, observing equipment, and materials; larger groups may occasionally
      require some power or A/V support at the venue.
    </p>

    <div class="mt-10 grid gap-6 sm:grid-cols-3">
      {
        samplePhotos.map((photo) => (
          <figure class="overflow-hidden rounded-xl border border-subtle bg-space-card">
            <img src={photo.src} alt={photo.alt} loading="lazy" class="h-40 w-full object-cover" />
            <figcaption class="px-3 py-2 text-xs text-ink-muted">{photo.caption}</figcaption>
          </figure>
        ))
      }
    </div>
    <p class="mt-3 text-sm text-ink-muted">A few examples of what guests may see through the eyepiece or on-screen.</p>
  </section>

  <section class="border-t border-subtle bg-space-card/40">
    <div class="mx-auto max-w-4xl px-6 py-20">
      <h2 class="section-heading">Program Offerings</h2>
      <div class="mt-10 grid gap-8 sm:grid-cols-2">
        <div class="card">
          <h3 class="font-display text-xl text-nebula-teal">A Visual Telescope Operator</h3>
          <p class="mt-2 text-sm text-ink-muted">
            The personal connection of viewing one-on-one through the eyepiece — an inky black sky covered in
            shimmering stars, like diamonds on velvet.
          </p>
          <ul class="mt-4 space-y-3 text-sm text-ink-muted">
            {visualPoints.map((point) => <li>• {point}</li>)}
          </ul>
        </div>
        <div class="card">
          <h3 class="font-display text-xl text-nebula-violet">An Electronically Assisted (EAA) Operator</h3>
          <p class="mt-2 text-sm text-ink-muted">
            Everyone views at once, easy for young and old alike — with more color and more detail on fainter
            objects than the eye alone can see.
          </p>
          <ul class="mt-4 space-y-3 text-sm text-ink-muted">
            {eaaPoints.map((point) => <li>• {point}</li>)}
          </ul>
        </div>
      </div>

      <div class="mt-10 grid gap-6 sm:grid-cols-2">
        <figure class="overflow-hidden rounded-xl border border-subtle bg-space-card">
          <img
            src="/images/star-tours-visual-child.jpg"
            alt="A young child looking through a visual telescope eyepiece in daylight"
            loading="lazy"
            class="h-56 w-full object-cover"
          />
          <figcaption class="px-4 py-3 text-sm text-ink-muted">
            A visual telescope makes for a personal, one-on-one view — for any age.
          </figcaption>
        </figure>
        <figure class="overflow-hidden rounded-xl border border-subtle bg-space-card">
          <img
            src="/images/star-tours-eaa-orion-monitor.jpg"
            alt="An EAA telescope live-stacking the Orion Nebula onto a monitor at night"
            loading="lazy"
            class="h-56 w-full object-cover"
          />
          <figcaption class="px-4 py-3 text-sm text-ink-muted">
            An EAA telescope live-stacking the Orion Nebula for the whole group to see at once.
          </figcaption>
        </figure>
      </div>

      <figure class="mt-6 overflow-hidden rounded-xl border border-subtle bg-space-card">
        <img
          src="/images/star-tours-event-crowd.jpg"
          alt="A large crowd gathered at dusk among lit cacti for a PAS Star Tours event"
          loading="lazy"
          class="w-full object-cover"
        />
        <figcaption class="px-4 py-3 text-sm text-ink-muted">
          Star Tours events scale from a single family's backyard to large public and corporate gatherings.
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-6 py-20">
    <h2 class="section-heading">Astronomy Topic Presentations</h2>
    <p class="mt-4 text-ink-muted">
      Various astronomy-related presentations are available that may not require a telescope operator.
    </p>
    <ul class="mt-6 grid gap-3 sm:grid-cols-2">
      {
        presentations.map((item) => (
          <li class="rounded-lg border border-subtle bg-space-card px-5 py-4 text-ink-muted">{item}</li>
        ))
      }
    </ul>
    <p class="mt-6 text-ink-muted">
      Have you ever held a rock that floated through the solar system for billions of years? In addition to
      superb telescope viewing, PAS also brings large, stunning photos of deep sky objects from the Hubble and
      James Webb telescopes, along with a collection of meteorites found from locations around the globe. We
      encourage questions and conversation on any astronomical topic — come find out why the North Star never
      changes position, why the Moon is covered in impact craters while Earth has so few, and how new stars are
      born from the remnants of supernovae, leaving us all made of stardust. There's something for any age group.
    </p>
    <figure class="mt-8 overflow-hidden rounded-xl border border-subtle bg-space-card">
      <img
        src="/images/star-tours-presentation-night.jpg"
        alt="A crowd gathered around a lit presentation table at a night Star Tours event"
        loading="lazy"
        class="w-full object-cover"
      />
      <figcaption class="px-4 py-3 text-sm text-ink-muted">
        Guests of all ages gather around a presentation table at a night event.
      </figcaption>
    </figure>
  </section>

  <section class="border-t border-subtle bg-space-card/40">
    <div class="mx-auto max-w-4xl px-6 py-20">
      <h2 class="section-heading">Book an Event</h2>
      <p class="mt-4 text-ink-muted">
        If your organization, business, school, or scout troop is interested in scheduling a private event,
        contact us at <a href="mailto:startours@pasaz.org" class="text-nebula-teal hover:underline">startours@pasaz.org</a> and
        include the following:
      </p>
      <ul class="mt-6 grid gap-3 sm:grid-cols-2">
        {
          bookingInfo.map((item) => (
            <li class="rounded-lg border border-subtle bg-space-card px-5 py-4 text-sm text-ink-muted">{item}</li>
          ))
        }
      </ul>
      <a href="mailto:startours@pasaz.org" class="btn-primary mt-8">Email startours@pasaz.org</a>
    </div>
  </section>
</BaseLayout>
