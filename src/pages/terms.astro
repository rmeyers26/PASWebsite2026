---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';

const siteSettings = (await getEntry('site-settings', 'data'))!.data;
const lastUpdated = 'August 12, 2026';
---

<BaseLayout
  title="Terms & Conditions"
  description="The terms and conditions for using the Phoenix Astronomical Society website."
>
  <section class="mx-auto max-w-4xl px-6 py-24">
    <span class="glass-badge mb-6">
      <span class="h-1.5 w-1.5 rounded-full bg-nebula-teal shadow-glow-teal" />
      Legal
    </span>
    <h1 class="font-display text-d2 tracking-tight text-ink-primary">Terms & Conditions</h1>
    <p class="mt-4 text-sm text-ink-muted">Last updated: {lastUpdated}</p>

    <div class="mt-10 flex flex-col gap-10 text-ink-muted">
      <p>
        These terms and conditions govern your use of this website, operated by the Phoenix Astronomical Society
        ("PAS," "we," "us," or "our"). By using this site, you agree to these terms. If you do not agree, please
        do not use the site.
      </p>

      <div>
        <h2 class="section-heading">Use of This Site</h2>
        <p class="mt-4">
          This website is provided to share information about PAS — our events, membership, resources, and
          activities. You agree to use the site only for lawful purposes and not to attempt to disrupt its
          operation, scrape or misuse its content, or interfere with other users' access to it.
        </p>
      </div>

      <div>
        <h2 class="section-heading">Intellectual Property</h2>
        <p class="mt-4">
          The text, images, logo, and other content on this site belong to PAS or its licensors, unless otherwise
          noted. You may view and share this content for personal, non-commercial purposes, but you may not
          reproduce, redistribute, or use it commercially without our prior written permission.
        </p>
      </div>

      <div>
        <h2 class="section-heading">Third-Party Links & Services</h2>
        <p class="mt-4">
          This site links to and embeds a few third-party services, each governed by its own terms:
        </p>
        <ul class="mt-4 list-disc space-y-2 pl-6">
          <li>
            <strong class="text-ink-primary">Google</strong> — powers the embedded maps on our{' '}
            <a href="/events" class="text-nebula-teal hover:underline">Events</a> and{' '}
            <a href="/sky-conditions" class="text-nebula-teal hover:underline">Sky Conditions</a> pages.
          </li>
          <li>
            <strong class="text-ink-primary">Bookwhen</strong> — handles our event calendar and registrations,
            embedded on the <a href="/events" class="text-nebula-teal hover:underline">Events</a> page.
          </li>
          <li>
            <strong class="text-ink-primary">PayPal</strong> — processes membership dues on the{' '}
            <a href="/join" class="text-nebula-teal hover:underline">Join</a> page.
          </li>
        </ul>
        <p class="mt-4">
          We are not responsible for the content, accuracy, or practices of these third-party services. Please
          review their own terms and privacy policies before use.
        </p>
      </div>

      <div>
        <h2 class="section-heading">No Warranty</h2>
        <p class="mt-4">
          This site is provided "as is," without warranties of any kind. Information such as event schedules and
          sky conditions is provided for convenience and may not always be complete, current, or accurate. We do
          not guarantee the site will be available at all times or free of errors.
        </p>
      </div>

      <div>
        <h2 class="section-heading">Limitation of Liability</h2>
        <p class="mt-4">
          To the fullest extent permitted by law, PAS shall not be liable for any damages arising from your use
          of, or inability to use, this website.
        </p>
      </div>

      <div>
        <h2 class="section-heading">Changes to These Terms</h2>
        <p class="mt-4">
          We may update these terms and conditions from time to time. Changes will be posted on this page with an
          updated "Last updated" date above.
        </p>
      </div>

      <div>
        <h2 class="section-heading">Contact Us</h2>
        <p class="mt-4">
          Questions about these terms can be sent to{' '}
          <a href={`mailto:${siteSettings.webmasterEmail}`} class="text-nebula-teal hover:underline">
            {siteSettings.webmasterEmail}
          </a>{' '}
          or{' '}
          <a href={`mailto:${siteSettings.email}`} class="text-nebula-teal hover:underline">
            {siteSettings.email}
          </a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
