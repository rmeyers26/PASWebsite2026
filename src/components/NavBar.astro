---
import { Image } from 'astro:assets';
import pasLogo from '../assets/images/pas-logo.png';

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/events', label: 'Events' },
  { href: '/star-tours', label: 'Star Tours', highlight: true },
  { href: '/telescope-workshops', label: 'Workshops' },
  { href: '/sky-conditions', label: 'Sky Conditions' },
  { href: '/learn', label: 'Learn' },
  { href: '/exoplanets', label: 'Exoplanets' },
  { href: '/contact', label: 'Contact' },
];

// Astro's static build serves subpages with a trailing slash (/events/), so
// strip it before comparing against the slash-free hrefs above — otherwise no
// nav item is ever marked active outside the homepage.
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<header class="sticky top-0 z-50 border-b border-subtle bg-space-base/60 backdrop-blur-2xl">
  <nav class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-6 py-4" aria-label="Primary">
    <a href="/" class="flex flex-none items-center gap-2.5 font-display text-base tracking-tight text-ink-primary">
      <Image src={pasLogo} alt="Phoenix Astronomical Society logo" width={72} height={72} loading="eager" fetchpriority="high" class="h-9 w-9 flex-none" />
      <span class="hidden whitespace-nowrap xl:inline">Phoenix Astronomical Society</span>
      <span class="xl:hidden">PAS</span>
    </a>
    <ul class="hidden items-center gap-5 lg:flex xl:gap-6">
      {
        navItems.map((item) => {
          const isActive = currentPath === item.href;
          return (
            <li>
              <a
                href={item.href}
                class:list={[
                  'whitespace-nowrap text-sm transition',
                  item.highlight
                    ? 'font-bold tracking-wide text-nebula-amber hover:text-nebula-amber/80'
                    : 'font-medium hover:text-nebula-teal',
                  !item.highlight && isActive ? 'text-nebula-teal' : '',
                  !item.highlight && !isActive ? 'text-ink-primary' : '',
                ]}
                aria-current={isActive ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })
      }
    </ul>
    <a href="/join" class="btn-primary hidden flex-none whitespace-nowrap px-5 py-2.5 text-sm lg:inline-flex">Join PAS</a>
    <details class="mobile-menu lg:hidden">
      <summary
        class="flex h-11 w-11 cursor-pointer list-none items-center justify-center text-ink-primary"
        aria-label="Open menu"
        aria-expanded="false"
      >
        <svg
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="4" y1="6" x2="20" y2="6" />
          <line x1="4" y1="12" x2="20" y2="12" />
          <line x1="4" y1="18" x2="20" y2="18" />
        </svg>
      </summary>
      <ul class="absolute left-4 right-4 top-full mt-2 flex max-h-[calc(100vh-6rem)] flex-col gap-1 overflow-y-auto rounded-2xl border border-subtle bg-space-base px-6 py-4 shadow-2xl">
        {
          navItems.map((item) => {
            const isActive = currentPath === item.href;
            return (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    'block py-2',
                    item.highlight ? 'font-bold text-nebula-amber' : 'text-ink-primary',
                  ]}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
        <li>
          <a href="/join" class="mt-2 block py-2 font-semibold text-nebula-teal">
            Join PAS
          </a>
        </li>
      </ul>
    </details>
  </nav>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
  const summary = menu?.querySelector('summary');

  menu?.addEventListener('toggle', () => {
    summary?.setAttribute('aria-expanded', String(menu.open));
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.open = false;
    });
  });
</script>
