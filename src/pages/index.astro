---
import BaseLayout from '../layouts/BaseLayout.astro';
import SpaceHero from '../components/SpaceHero.astro';
import PlaceholderNote from '../components/PlaceholderNote.astro';
import ApodOfTheDay from '../components/ApodOfTheDay.astro';

const benefits = [
  {
    title: 'Monthly Lecture Series',
    accent: 'text-nebula-teal',
    body: 'Guest speakers and member talks covering observing, astrophotography, and the latest research.',
  },
  {
    title: 'Public Star Parties',
    accent: 'text-nebula-violet',
    body: 'Free, open-to-the-public observing nights — a welcoming first stop for beginners of any age.',
  },
  {
    title: 'Telescope Workshops',
    accent: 'text-nebula-amber',
    body: "Free, hands-on help choosing, setting up, and getting the most out of your own telescope.",
  },
  {
    title: 'Star Tours Outreach',
    accent: 'text-nebula-teal',
    body: 'Bring PAS telescopes and presenters to your school, scout troop, or community group.',
  },
  {
    title: 'Group Trips',
    accent: 'text-nebula-violet',
    body: 'Members-only excursions, like private tours of Lowell Observatory in Flagstaff.',
  },
  {
    title: 'A Club Since 1948',
    accent: 'text-nebula-amber',
    body: 'Nearly eight decades of bringing Arizona’s skies to students, families, and lifelong astronomers.',
  },
];

const upcomingEventTypes = [
  {
    title: 'Monthly Meeting',
    accent: 'text-nebula-teal',
    body: 'Our Lecture Series meeting, with a guest speaker and club updates.',
  },
  {
    title: 'Public Star Party',
    accent: 'text-nebula-violet',
    body: 'Free, open-air observing — bring your own gear or just look through ours.',
  },
  {
    title: 'Telescope Workshop',
    accent: 'text-nebula-amber',
    body: "Can't find anything in your telescope? Bring it and we'll help.",
  },
];

const comingSoon = [
  'Member astrophotography gallery & contest',
  'Observing Awards & PAS Academy youth challenges',
  '"Tonight in Arizona" live sky dashboard',
  'Member dashboard & event registration',
];
---

<BaseLayout
  title="Home"
  description="The Phoenix Astronomical Society is a 501(c)(3) nonprofit astronomy club serving Phoenix, Arizona since 1948."
>
  <SpaceHero
    eyebrow="Phoenix Astronomical Society"
    title="Explore the Universe Together"
    subtitle="Join one of Arizona's most active astronomy communities for observing, astrophotography, education, and discovery."
  >
    <div class="mt-10 flex flex-wrap justify-center gap-4">
      <a href="/join" class="btn-primary">Join the Club</a>
      <a href="/events" class="btn-secondary">Upcoming Events</a>
    </div>
  </SpaceHero>

  <section class="mx-auto max-w-6xl px-6 py-20">
    <h2 class="section-heading">Why Join PAS</h2>
    <p class="mt-3 max-w-2xl text-ink-muted">
      Concrete reasons members stick around — not just a meeting on the calendar.
    </p>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        benefits.map((benefit) => (
          <div class="card">
            <h3 class={`font-display text-lg ${benefit.accent}`}>{benefit.title}</h3>
            <p class="mt-3 text-ink-muted">{benefit.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="border-t border-subtle bg-space-card/40">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <h2 class="section-heading">Upcoming Events</h2>
      <p class="mt-3 max-w-2xl text-ink-muted">
        Meetings, star parties, and workshops happen regularly throughout the year.
      </p>
      <div class="mt-10 grid gap-6 sm:grid-cols-3">
        {
          upcomingEventTypes.map((event) => (
            <div class="card">
              <h3 class={`font-display text-lg ${event.accent}`}>{event.title}</h3>
              <p class="mt-3 text-ink-muted">{event.body}</p>
            </div>
          ))
        }
      </div>
      <div class="mt-10">
        <a href="/events" class="btn-primary">View Full Calendar</a>
      </div>
    </div>
  </section>

  <ApodOfTheDay />

  <section class="border-t border-subtle bg-space-card/40">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <h2 class="section-heading">Coming Soon</h2>
      <p class="mt-3 max-w-2xl text-ink-muted">
        This is Phase 1 of a multi-phase rebuild. The site's visual identity and core information are live now —
        these member-facing features are on the way next.
      </p>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2">
        {
          comingSoon.map((item) => (
            <li class="flex items-center gap-3 rounded-lg border border-subtle bg-space-card px-5 py-4 text-ink-muted">
              <span class="h-2 w-2 flex-none rounded-full bg-nebula-teal" aria-hidden="true" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-6 py-16">
    <PlaceholderNote
      label="Homepage copy above uses placeholder framing where specific facts (exact meeting cadence, current officer names) aren't yet confirmed — see /about, /events, and /contact for details."
    />
  </section>
</BaseLayout>
