---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" description="This page doesn't exist.">
  <section class="mx-auto max-w-2xl px-6 py-32 text-center">
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-nebula-amber">404</p>
    <h1 class="mt-4 font-display text-4xl text-ink-primary">Lost in Space</h1>
    <p class="mt-4 text-ink-muted">We couldn't find that page. Let's get you back to clearer skies.</p>
    <a href="/" class="btn-primary mt-8">Back to Home</a>
  </section>
</BaseLayout>
