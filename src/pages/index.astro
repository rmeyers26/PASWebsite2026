---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SpaceHero from '../components/SpaceHero.astro';
import ApodOfTheDay from '../components/ApodOfTheDay.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import outreachPhoto from '../assets/images/star-tours-touch-meteorite.jpg';
import milkyWay from '../assets/images/gallery/kris-mlak-milky-way.jpg';
import soulNebula from '../assets/images/gallery/richard-sauerbrun-soul-nebula.jpg';
import theSun from '../assets/images/gallery/mark-johnston-sun.jpg';
import ldn541 from '../assets/images/gallery/caleb-sexton-ldn-541.png';

const galleryTeaser = [
  { src: milkyWay, alt: 'The Milky Way arching over a desert mountain silhouette', caption: 'The Milky Way — Kris Mlak', color: true },
  { src: soulNebula, alt: 'IC 1848, the Soul Nebula, in red and teal emission gas', caption: 'The Soul Nebula — Richard Sauerbrun', color: true },
  { src: theSun, alt: 'A hydrogen-alpha close-up of a solar prominence', caption: 'The Sun — Mark Johnston', color: true },
  { src: ldn541, alt: 'LDN 541, a dark nebula in Cepheus threading a dense star field', caption: 'LDN 541 — Caleb Sexton', color: true },
];

const benefits = [
  {
    title: 'Public Star Parties',
    accent: 'text-nebula-violet',
    body: 'Free, open-to-the-public observing nights — a welcoming first stop for beginners of any age. No telescope, no experience, and no membership required: turn up, get in line at an eyepiece, and let a member walk you across the sky.',
    featured: true,
  },
  {
    title: 'Monthly Lecture Series',
    accent: 'text-nebula-teal',
    body: 'Guest speakers and member talks covering observing, astrophotography, and the latest research.',
  },
  {
    title: 'Telescope Workshops',
    accent: 'text-nebula-amber',
    body: "Free, hands-on help choosing, setting up, and getting the most out of your own telescope.",
  },
  {
    title: 'Star Tours Outreach',
    accent: 'text-nebula-teal',
    body: 'Bring PAS telescopes and presenters to your school, scout troop, or community group.',
  },
  {
    title: 'Group Trips',
    accent: 'text-nebula-violet',
    body: 'Members-only excursions, like private tours of Lowell Observatory in Flagstaff.',
  },
  {
    title: 'A Club Since 1948',
    accent: 'text-nebula-amber',
    body: 'Nearly eight decades of bringing Arizona’s skies to students, families, and lifelong astronomers.',
  },
];

const upcomingEventTypes = [
  {
    title: 'Monthly Meeting',
    accent: 'text-nebula-teal',
    body: 'Our Lecture Series meeting, with a guest speaker and club updates.',
  },
  {
    title: 'Public Star Party',
    accent: 'text-nebula-violet',
    body: 'Free, open-air observing — bring your own gear or just look through ours.',
  },
  {
    title: 'Telescope Workshop',
    accent: 'text-nebula-amber',
    body: "Can't find anything in your telescope? Bring it and we'll help.",
  },
];

const accentClasses = {
  violet: 'text-nebula-violet',
  teal: 'text-nebula-teal',
  amber: 'text-nebula-amber',
};

// Editable by club officers via the Sveltia CMS ("Special Interest Groups")
// — an officer can disable a group (put it on hiatus) or stage a new one
// without a code change. See src/content/special-interest-groups/.
const specialInterestGroups = (await getCollection('special-interest-groups'))
  .filter((group) => group.data.enabled)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Home"
  description="The Phoenix Astronomical Society is a 501(c)(3) nonprofit astronomy club serving Phoenix, Arizona since 1948."
>
  <SpaceHero
    eyebrow="Phoenix Astronomical Society"
    title="Explore the Universe"
    titleTail="Together"
    subtitle="Join one of Arizona's most active astronomy communities for observing, astrophotography, education, and discovery."
  >
    <div class="mt-10 flex flex-wrap justify-center gap-4">
      <a href="/join" class="btn-primary">Join PAS</a>
      <a href="/events" class="btn-secondary">Upcoming Events</a>
      <a href="/scholarship#donate" class="btn-secondary">Donate</a>
    </div>
  </SpaceHero>

  <section class="mx-auto max-w-3xl px-6 py-24 sm:py-28">
    <p class="font-display text-3xl leading-[1.15] tracking-tight text-ink-primary sm:text-4xl">
      Phoenix has been looking up since <span class="text-nebula-amber">1948</span>. And for nearly eight
      decades, whenever someone paused to wonder what was shining overhead, a member of this club was there
      beside a telescope, ready to explain what they were seeing and inspire the next generation of
      skywatchers.
    </p>
    <p class="mt-8 text-lg text-ink-muted">
      We're a 501(c)(3) nonprofit of beginners, backyard observers, astrophotographers, and lifelong amateurs.
      The telescopes are a means to an end; the point is the people around them.
    </p>
  </section>

  <ApodOfTheDay />

  <section class="border-t border-subtle">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <h2 class="section-heading">What Our Members See</h2>
      <p class="mt-3 max-w-2xl text-ink-muted">
        NASA isn't the only one with a picture of the day — PAS members shoot the Milky Way, nebulae, and the
        Sun from right here in Arizona.
      </p>
      <div class="mt-10">
        <PhotoGrid photos={galleryTeaser} />
      </div>
      <div class="mt-10">
        <a href="/gallery" class="btn-primary">View the Full Gallery</a>
      </div>
    </div>
  </section>

  <section class="border-t border-subtle">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <h2 class="section-heading">Upcoming Events</h2>
      <p class="mt-3 max-w-2xl text-ink-muted">
        Meetings, star parties, and workshops happen regularly throughout the year.
      </p>
      <div class="mt-10 grid gap-6 sm:grid-cols-3">
        {
          upcomingEventTypes.map((event) => (
            <div class="card">
              <h3 class={`font-display text-lg ${event.accent}`}>{event.title}</h3>
              <p class="mt-3 text-ink-muted">{event.body}</p>
            </div>
          ))
        }
      </div>
      <div class="mt-10">
        <a href="/events" class="btn-primary">View Full Calendar</a>
      </div>
    </div>
  </section>

  <section class="relative isolate flex min-h-[26rem] items-end overflow-hidden sm:min-h-[32rem]">
    <Image
      src={outreachPhoto}
      alt="A PAS member holding out a meteorite for visitors to touch at an outreach event"
      widths={[768, 1280, 1800]}
      sizes="100vw"
      class="band-parallax absolute inset-0 -z-10 h-full w-full object-cover"
    />
    <!-- Two scrims: the vertical one seats the band into the page, the horizontal
         one keeps the text column legible regardless of what's behind it. -->
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-t from-space-base via-space-base/75 to-space-base/30"
      aria-hidden="true"
    >
    </div>
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-r from-space-base/95 via-space-base/55 to-transparent"
      aria-hidden="true"
    >
    </div>
    <div class="mx-auto w-full max-w-6xl px-6 py-16">
      <h2 class="max-w-2xl font-display text-4xl leading-tight tracking-tight text-ink-primary sm:text-5xl">
        A PAS Star Tour is more than a look through a telescope—it's a guided journey through the night sky.
      </h2>
      <p class="mt-6 max-w-2xl text-lg text-ink-muted">
        Every telescope is staffed by a knowledgeable PAS volunteer who helps visitors discover planets, galaxies,
        nebulae, and star clusters while explaining what they're seeing. If clouds roll in, our meteorites,
        displays, and presenters ensure there's still plenty to explore and enjoy.
      </p>
      <a href="/star-tours" class="btn-primary mt-8">Bring PAS to Your Group</a>
    </div>
  </section>

  <section class="border-t border-subtle bg-space-card/40">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <h2 class="section-heading">Why Join PAS</h2>
      <p class="mt-3 max-w-2xl text-ink-muted">
        Concrete reasons members stick around — not just a meeting on the calendar.
      </p>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          benefits.map((benefit) =>
            benefit.featured ? (
              <div class="card card-featured flex flex-col justify-between sm:col-span-2 lg:row-span-2">
                <div>
                  <span class="glass-badge">Start here</span>
                  <h3 class={`mt-5 font-display text-2xl sm:text-3xl ${benefit.accent}`}>{benefit.title}</h3>
                  <p class="mt-4 text-lg text-ink-muted">{benefit.body}</p>
                </div>
                <a href="/events" class="btn-secondary mt-8 self-start">Find the Next One</a>
              </div>
            ) : (
              <div class="card">
                <h3 class={`font-display text-lg ${benefit.accent}`}>{benefit.title}</h3>
                <p class="mt-3 text-ink-muted">{benefit.body}</p>
              </div>
            ),
          )
        }
      </div>
      <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3">
        <a href="/join" class="btn-primary">Join PAS</a>
        <a href="/learn#start-here" class="text-sm font-semibold text-nebula-teal hover:underline">
          New to astronomy? See the beginner path →
        </a>
      </div>
    </div>
  </section>

  {
    specialInterestGroups.length > 0 && (
      <section id="special-interest-groups" class="scroll-mt-[4.5rem] border-t border-subtle">
        <div class="mx-auto max-w-5xl px-6 py-20">
          <h2 class="section-heading">Special Interest Groups</h2>
          <p class="mt-3 max-w-2xl text-ink-muted">
            Smaller member-run groups that go deep on one corner of the hobby, meeting outside the main monthly
            calendar.
          </p>
          <div class="mt-10 grid gap-6 sm:grid-cols-2">
            {specialInterestGroups.map(({ data: group }) => (
              <a href={group.url} class="card block">
                <h3 class={`font-display text-lg ${accentClasses[group.accent]}`}>
                  {group.title} <span class="text-ink-muted">({group.abbr})</span>
                </h3>
                <p class="mt-3 text-ink-muted">{group.body}</p>
              </a>
            ))}
          </div>
          <p class="mt-8 text-ink-muted">
            <span aria-hidden="true">*</span> PAS membership is required to take part in a special interest group.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="/join" class="btn-primary">Become a Member</a>
            <a href="/contact" class="btn-secondary">Ask About a Group</a>
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  /* Signature scroll moment: the outreach photograph drifts against the page as
     the band crosses the viewport. Driven entirely by the CSS scroll-timeline —
     no JS, no scroll listener — and only where the browser supports it, so
     everywhere else the image is simply static. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .band-parallax {
        transform-origin: center;
        animation: band-drift linear both;
        animation-timeline: view();
        animation-range: entry 0% exit 100%;
      }

      @keyframes band-drift {
        from {
          transform: scale(1.18) translateY(-3.5%);
        }
        to {
          transform: scale(1.18) translateY(3.5%);
        }
      }
    }
  }
</style>
