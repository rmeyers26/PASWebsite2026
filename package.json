{
  "name": "pas-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint \"src/**/*.{js,mjs,ts,astro}\" \"*.{js,mjs,ts}\"",
    "lint:fix": "eslint \"src/**/*.{js,mjs,ts,astro}\" \"*.{js,mjs,ts}\" --fix",
    "format": "prettier --write \"src/**/*.{js,mjs,ts,astro,css}\" \"*.{js,mjs,ts,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,mjs,ts,astro,css}\" \"*.{js,mjs,ts,json,md}\""
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.3",
    "astro-og-canvas": "^0.13.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@eslint/js": "^10.0.1",
    "@types/three": "^0.185.3",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-tailwindcss": "^4.2.0",
    "globals": "^17.11.0",
    "pagefind": "^1.5.2",
    "playwright-core": "^1.62.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "nanoid": "^3.3.18",
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
