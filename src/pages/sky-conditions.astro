---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import heroPhoto from '../assets/images/star-tours-eaa-night.jpg';

const astrosphericUrl = 'https://www.astrospheric.com/?Latitude=33.4484&Longitude=-112.074&Loc=Forecast';
const astrosphericLat = 33.4484;
const astrosphericLng = -112.074;

// VirtualSky (Las Cumbres Observatory) reads its config straight from this
// URL's query string, so the interactive sky chart below opens centered on
// Phoenix instead of wherever the visitor's browser happens to be.
const virtualSkyUrl =
  `https://virtualsky.lco.global/embed/index.html?longitude=${astrosphericLng}&latitude=${astrosphericLat}` +
  '&projection=stereo&constellations=true&constellationlabels=true&showstarlabels=true&az=180&live=true';

// Peak dates for the year's six major showers, from the American Meteor
// Society's annual calendar — stable to within a day year over year, but
// worth a quick cross-check against amsmeteors.org each January since AMS
// republishes updated calendars annually. Month/day only (no year): the
// client script below works out whether each has already peaked this year
// and rolls it to next year automatically, so this list never goes stale
// the way a hardcoded year would.
const meteorShowers = [
  { name: 'Quadrantids', month: 1, day: 3, radiant: 'Boötes' },
  { name: 'Lyrids', month: 4, day: 22, radiant: 'Lyra' },
  { name: 'Perseids', month: 8, day: 12, radiant: 'Perseus' },
  { name: 'Orionids', month: 10, day: 21, radiant: 'Orion' },
  { name: 'Leonids', month: 11, day: 17, radiant: 'Leo' },
  { name: 'Geminids', month: 12, day: 14, radiant: 'Gemini' },
];
const monthNames = [
  'January', 'February', 'March', 'April', 'May', 'June',
  'July', 'August', 'September', 'October', 'November', 'December',
];

const telescopeTargets = [
  {
    scope: '5" Refractor',
    seasons: [
      { season: 'Anytime', text: 'The Moon and the five naked-eye planets — Mercury, Venus, Mars, Jupiter (and its moons), and Saturn (and its moons)' },
      { season: 'Fall', text: 'NGC 7009 Saturn Nebula, outskirts of the Valley (Bortle 4–5)' },
      { season: 'Winter', text: 'NGC 7662 Blue Snowball Nebula; NGC 2169 "37" star cluster, outskirts of the Valley (Bortle 4–5)' },
      { season: 'Spring', text: 'Stargate asterism (two nested triangles), outskirts of the Valley (Bortle 4–5); NGC 3242 Ghost of Jupiter Nebula, dark sky like the Antennas area (Bortle 2)' },
      { season: 'Summer', text: 'Deep red carbon star 1 Lyrae; Collinder 399 Coat Hanger asterism, outskirts of the Valley (Bortle 4–5)' },
    ],
  },
  {
    scope: '6" Dobsonian Reflector',
    seasons: [
      { season: 'Fall', text: 'Double Cluster in Perseus; Andromeda Galaxy M31, outskirts of the Valley (Bortle 4–5)' },
      { season: 'Winter', text: 'Pleiades Open Cluster M45; Orion Nebula M42, in Phoenix (Bortle 6–8)' },
      { season: 'Spring', text: 'Beehive Open Cluster M44; Hercules Globular Cluster M13 (Bortle 4–5)' },
      { season: 'Summer', text: "Ptolemy's Open Cluster M7 in Scorpius (Bortle 4–5); Lagoon Nebula M8, dark sky (Bortle 2)" },
    ],
  },
  {
    scope: '8" Newtonian Reflector',
    seasons: [
      { season: 'Fall', text: 'Gamma Andromedae blue-and-gold double star, in Phoenix (Bortle 6–8)' },
      { season: 'Winter', text: 'Orion Nebula M42, outskirts of the Valley (Bortle 4–5)' },
      { season: 'Spring', text: 'M81 and M82 galaxies, dark sky like the Antennas location (Bortle 2)' },
      { season: 'Summer', text: 'M13 Globular Cluster, outskirts of the Valley (Bortle 4–5)' },
    ],
  },
  {
    scope: '9¼" Schmidt-Cassegrain',
    seasons: [
      { season: 'Fall', text: "Albireo and Gamma Andromedae blue-and-gold double stars, in Phoenix (Bortle 6–8); Stephan's Quintet of galaxies (Hickson 92 / NGC 7317, 7318a, 7318b, 7319, 7320), dark sky area (Bortle 2)" },
      { season: 'Winter', text: 'Orion and Running Man Nebulae M42 & M43, in Phoenix (Bortle 6–8); M35 Open Cluster, in Phoenix (Bortle 6–8)' },
      { season: 'Spring', text: 'Omega Centauri Globular Cluster, southern outskirts of Phoenix (Bortle 4–5); M35 Open Cluster, in Phoenix (Bortle 6–8)' },
      { season: 'Summer', text: 'Swan Nebula M17 (use an OIII filter) and Lagoon Nebula M8, if south of the Valley (Bortle 4–5)' },
    ],
  },
  {
    scope: '14" Dobsonian Reflector',
    seasons: [
      { season: 'Fall', text: 'Perseus Double Cluster, in Phoenix (Bortle 6–8); M37 Open Cluster, outskirts of the Valley (Bortle 4–5); M17 & M20 Nebulae and Open Clusters NGC 7789 and M11 Wild Duck, dark sky area like the Antennas (Bortle 2)' },
      { season: 'Winter', text: 'Orion Nebula M42, in Phoenix (Bortle 6–8); Andromeda Galaxy M31, outskirts of the Valley (Bortle 4–5); Open Clusters M41 and M50, dark area (Bortle 2)' },
      { season: 'Spring', text: 'M81 and M82 galaxies, outskirts of the Valley (Bortle 4–5); M51 Whirlpool Galaxy, M5 & M13 globular clusters, and Virgo region galaxies (M86 and surrounding area), all in a dark area (Bortle 2)' },
      { season: 'Summer', text: 'M57 Ring Nebula, outskirts of the Valley (Bortle 4–5); NGC 6826 Blinking Planetary Nebula, Helix Nebula NGC 7293, Veil Nebula Caldwell 33/34, Sculptor Galaxy NGC 253, M27 Dumbbell Nebula, dark area (Bortle 2)' },
    ],
  },
];

const binocularTargets = [
  {
    season: 'Fall',
    text: 'Andromeda Galaxy M31; Milky Way Galaxy; M15 Globular Cluster in Pegasus; Perseus Double Open Star Clusters',
  },
  {
    season: 'Winter',
    text: 'Pleiades Open Star Cluster M45 in Taurus; Orion Nebula M42; Open Star Cluster M35 in Gemini; M36, M37, and M38 open star clusters in Auriga; Betelgeuse in Orion (red-orange star); Rigel in Orion (blue-white star); Aldebaran in Taurus (red giant star)',
  },
  {
    season: 'Spring',
    text: 'Beehive Open Star Cluster M44 in Cancer; M50 Open Star Cluster in Monoceros; M41 Open Star Cluster in Canis Major; Mizar double star in Ursa Major',
  },
  {
    season: 'Summer',
    text: 'Lagoon Nebula M8 and Trifid Nebula M20 in Sagittarius; Hercules Globular Cluster M13; M25 Open Cluster and M22 Globular Cluster in Sagittarius; Delta Lyrae (red/blue double star); Epsilon Lyrae (wide components of the "double double" star); "False Albireo" (Alpha and 8 Vulpeculae double star); Omicron 1 and 2 (blue/orange double star); 31 Cygni (wide triple star); Deneb in Cygnus (blue-white star); the Summer Triangle (Deneb in Cygnus, Vega in Lyra, Altair in Aquila); Collinder 399 "Coat Hanger" asterism in Vulpecula',
  },
];

const observingSites = [
  {
    bortle: '1.0',
    name: '18 miles south of Jacob Lake, 22 miles north of the North Rim of the Grand Canyon',
    map: 'https://goo.gl/maps/mEueApUHSBngjVD79',
  },
  {
    bortle: '1.5',
    name: 'Kaibab Lodge, 18 miles north of the North Rim of the Grand Canyon',
    map: 'https://www.google.com/maps/place/Kaibab+Lodge/@36.3751654,-112.4968502,10.09z',
  },
  {
    bortle: '1.5',
    name: 'Wupatki / Doney Mountain Lunch & View Area, about 45 minutes north of Flagstaff off Route 89',
    map: 'https://goo.gl/maps/BGPfWx732xc6Vk6x6',
  },
  {
    bortle: '1.5',
    name: 'Southwestern Research Station, Portal, AZ',
    map: 'https://www.google.com/maps/place/Southwestern+Research+Station/@31.8690854,-109.8007418,9.33z',
  },
  {
    bortle: '1.9',
    name: 'Moran Point, South Rim of the Grand Canyon',
    map: 'https://goo.gl/maps/WC6jNcx9kxEgcmGK6',
  },
  {
    bortle: '2.0',
    name: 'Pinewood Trailhead, eastern limits of Munds Park, about 20 miles south of Flagstaff',
    map: 'https://www.google.com/maps/place/Pinewood+Trailhead/@35.0180166,-111.8635961,9.63z',
  },
  {
    bortle: '2.0',
    name: 'Hovatter Rd. Antennas site, about 100 miles west of Central Phoenix',
    map: 'https://goo.gl/maps/ExigYzfoffeMFmfLA',
  },
  {
    bortle: '2.0',
    name: 'Tonto National Monument',
    map: 'https://www.google.com/maps/place/Tonto+National+Monument/@33.6658504,-111.4770201,9.81z',
  },
  {
    bortle: '2.6',
    name: 'Arcosanti, about 60 miles north of Phoenix',
    map: 'https://www.google.com/maps/place/Arcosanti,+AZ+86333/@34.3637874,-112.5410779,9.55z',
  },
  {
    bortle: '3.4',
    name: 'Pickett Post trailhead, about 60 miles SE of Phoenix off Highway 60',
    map: 'https://goo.gl/maps/Uopixr2yRxzsDAsDA',
  },
  {
    bortle: '3.9',
    name: 'Four Peaks cookout area, 18 miles north of Fort McDowell on the Beeline Highway turnoff (~33.678, -111.502)',
    map: 'https://www.google.com/maps/search/?api=1&query=33.67803,-111.50200',
  },
  { bortle: '4.0', name: 'Apache Wash Trailhead, North Phoenix', map: null },
  { bortle: '4.0', name: 'Buffalo Park, North Flagstaff', map: null },
  {
    bortle: '4.1',
    name: 'Needle Rock Recreation Area near Rio Verde (~33.768, -111.670)',
    map: 'https://www.google.com/maps/search/?api=1&query=33.76764,-111.67004',
  },
  { bortle: '4.2', name: 'Town of Tusayan, 5 miles south of the Grand Canyon', map: null },
  { bortle: '4.3', name: 'Cow Track Ranch, Carefree', map: null },
  {
    bortle: '4.3',
    name: 'Spur Cross Ranch Park, Cave Creek',
    map: 'https://www.maricopacountyparks.net/park-locator/spur-cross-ranch-conservation-area',
  },
  { bortle: '4.3', name: 'New River', map: null },
  { bortle: '4.3', name: 'Robbins Butte, east of Buckeye, about 40 miles SW of Phoenix', map: null },
  {
    bortle: '4.6',
    name: 'McDowell Mountain Park',
    map: 'https://www.maricopacountyparks.net/mcdowell-mountain-regional-park',
  },
  { bortle: '5.0', name: 'Paradise Valley Community College, Black Mountain Campus, North Valley', map: null },
  { bortle: '5.7', name: 'South Mountain Park, Phoenix', map: null },
];
---

<BaseLayout
  title="Sky Conditions & Observing Sites"
  description="Check tonight's astronomical forecast for the Phoenix area, plus Bortle-rated dark-sky observing sites and seasonal targets for telescopes and binoculars from the Phoenix Astronomical Society."
>
  <Hero
    image={heroPhoto}
    alt="A PAS electronically-assisted-astronomy rig under the night sky, lit red, with city lights on the horizon"
    eyebrow="Sky Conditions"
    title="Sky Conditions & Observing Sites"
    subtitle="Tonight's astronomical forecast for the Phoenix area, plus where PAS members go for dark skies and what's worth looking at once you're there."
    tone="dark"
  />

  <!-- This page runs long; an in-page nav keeps the four data sets reachable
       without scrolling back to the top. Sits directly beneath the sticky header. -->
  <nav
    aria-label="On this page"
    class="sticky top-[4.25rem] z-30 border-b border-subtle bg-space-base/90 backdrop-blur-xl"
  >
    <ul class="subnav-scroll mx-auto flex max-w-5xl gap-6 overflow-x-auto px-6 py-3 text-sm whitespace-nowrap">
      <li><a href="#forecast" class="text-ink-muted transition hover:text-nebula-teal">Tonight's Forecast</a></li>
      <li><a href="#skychart" class="text-ink-muted transition hover:text-nebula-teal">Sky Chart</a></li>
      <li><a href="#telescopes" class="text-ink-muted transition hover:text-nebula-teal">Telescopes</a></li>
      <li><a href="#binoculars" class="text-ink-muted transition hover:text-nebula-teal">Binoculars</a></li>
      <li><a href="#sites" class="text-ink-muted transition hover:text-nebula-teal">Observing Sites</a></li>
    </ul>
  </nav>

  <section id="forecast" class="mx-auto max-w-6xl px-6 py-20">
    <h2 class="section-heading">Tonight's Forecast</h2>

    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      <div class="card">
        <p class="text-sm font-semibold uppercase tracking-wide text-nebula-teal">Moon Tonight</p>
        <p class="mt-3 font-display text-2xl text-ink-primary">
          <span id="moon-phase-icon" aria-hidden="true">🌙</span>
          <span id="moon-phase-name">—</span>
        </p>
        <p class="mt-1 text-sm text-ink-muted" id="moon-phase-illum"></p>
        <noscript>
          <p class="mt-1 text-sm text-ink-muted">Requires JavaScript to compute tonight's phase.</p>
        </noscript>
      </div>
      <div class="card">
        <p class="text-sm font-semibold uppercase tracking-wide text-nebula-amber">Meteor Showers</p>
        <ul class="mt-3 space-y-2 text-sm">
          {
            meteorShowers.map((shower) => (
              <li
                class="flex items-baseline justify-between gap-3"
                data-shower-item
                data-month={shower.month}
                data-day={shower.day}
              >
                <span class="shower-name text-ink-primary">
                  {shower.name} <span class="text-ink-muted">({shower.radiant})</span>
                </span>
                <span class="shower-date flex-none text-ink-muted">
                  Peaks {monthNames[shower.month - 1]} {shower.day}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <p class="mt-8 text-ink-muted">
      If the forecast below doesn't load,{' '}
      <a href={astrosphericUrl} target="_blank" rel="noopener noreferrer" class="text-nebula-teal hover:underline">
        open it directly on Astrospheric</a>.
    </p>
    <div class="mt-8 overflow-hidden rounded-lg border border-subtle p-2">
      <iframe
        src={`https://www.astrospheric.com/?App=embedded&AppVersion=3&Latitude=${astrosphericLat}&Longitude=${astrosphericLng}`}
        loading="lazy"
        class="block h-[500px] w-full border-0"
        title="Astrospheric sky forecast for Phoenix, AZ"
      ></iframe>
    </div>
  </section>

  <section id="skychart" class="border-t border-subtle mx-auto max-w-6xl px-6 py-20">
    <h2 class="section-heading">Tonight's Sky Chart</h2>
    <p class="mt-4 text-ink-muted">
      An interactive planetarium centered on Phoenix — pan, zoom, and see what's up right now.
    </p>
    <p class="mt-4 text-ink-muted">
      If the chart below doesn't load,{' '}
      <a href={virtualSkyUrl} target="_blank" rel="noopener noreferrer" class="text-nebula-teal hover:underline">
        open it directly on VirtualSky</a>.
    </p>
    <noscript>
      <p class="mt-4 text-ink-muted">
        The sky chart requires JavaScript —{' '}
        <a href={virtualSkyUrl} target="_blank" rel="noopener noreferrer" class="text-nebula-teal hover:underline">
          view it on VirtualSky</a>.
      </p>
    </noscript>
    <div class="mt-8 overflow-hidden rounded-lg border border-subtle p-2">
      <iframe
        src={virtualSkyUrl}
        loading="lazy"
        class="block h-[500px] w-full border-0"
        title="Interactive sky chart for Phoenix, AZ"
      ></iframe>
    </div>
  </section>

  <script>
    // Pure math, computed client-side so it's accurate for the visitor's
    // actual "tonight" rather than whenever the site was last built/deployed
    // — the Astrospheric weather widget above is live for the same reason.
    const LUNAR_MONTH_DAYS = 29.530588853;
    const KNOWN_NEW_MOON_UTC = Date.UTC(2000, 0, 6, 18, 14);

    const MOON_PHASES: { max: number; name: string; icon: string }[] = [
      { max: 0.02, name: 'New Moon', icon: '🌑' },
      { max: 0.24, name: 'Waxing Crescent', icon: '🌒' },
      { max: 0.26, name: 'First Quarter', icon: '🌓' },
      { max: 0.49, name: 'Waxing Gibbous', icon: '🌔' },
      { max: 0.51, name: 'Full Moon', icon: '🌕' },
      { max: 0.74, name: 'Waning Gibbous', icon: '🌖' },
      { max: 0.76, name: 'Last Quarter', icon: '🌗' },
      { max: 0.98, name: 'Waning Crescent', icon: '🌘' },
      { max: 1.01, name: 'New Moon', icon: '🌑' },
    ];

    function updateMoonPhase() {
      const iconEl = document.getElementById('moon-phase-icon');
      const nameEl = document.getElementById('moon-phase-name');
      const illumEl = document.getElementById('moon-phase-illum');
      if (!iconEl || !nameEl || !illumEl) return;

      const ageDays = ((Date.now() - KNOWN_NEW_MOON_UTC) / 86_400_000) % LUNAR_MONTH_DAYS;
      const fraction = ((ageDays % LUNAR_MONTH_DAYS) + LUNAR_MONTH_DAYS) / LUNAR_MONTH_DAYS % 1;
      // Fraction of the disc lit — exact for a circular orbit approximation,
      // which is what a decorative widget like this needs, not an almanac.
      const illumination = Math.round((1 - Math.cos(2 * Math.PI * fraction)) / 2 * 100);
      const phase = MOON_PHASES.find((p) => fraction <= p.max) ?? MOON_PHASES[0];

      iconEl.textContent = phase.icon;
      nameEl.textContent = phase.name;
      illumEl.textContent = `${illumination}% illuminated`;
    }

    function updateMeteorShowers() {
      const items = document.querySelectorAll<HTMLLIElement>('[data-shower-item]');
      if (!items.length) return;

      const today = new Date();
      today.setHours(0, 0, 0, 0);

      let soonestItem: HTMLLIElement | null = null;
      let soonestDiff = Infinity;

      for (const item of items) {
        const month = Number(item.dataset.month) - 1;
        const day = Number(item.dataset.day);
        let next = new Date(today.getFullYear(), month, day);
        if (next < today) next = new Date(today.getFullYear() + 1, month, day);

        const dateEl = item.querySelector('.shower-date');
        if (dateEl) {
          const withYear = next.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
          dateEl.textContent = `Peaks ${withYear}`;
        }

        const diff = next.getTime() - today.getTime();
        if (diff < soonestDiff) {
          soonestDiff = diff;
          soonestItem = item;
        }
      }

      // Only one "Next Up" badge should ever exist — re-running on repeat
      // astro:page-load events (view transitions) must not stack another.
      document.querySelector('.shower-next-badge')?.remove();
      const nameEl = soonestItem?.querySelector('.shower-name');
      if (nameEl) {
        const badge = document.createElement('span');
        badge.textContent = 'Next Up';
        badge.className = 'shower-next-badge';
        nameEl.appendChild(badge);
      }
    }

    function updateSkyWidgets() {
      updateMoonPhase();
      updateMeteorShowers();
    }

    updateSkyWidgets();
    document.addEventListener('astro:page-load', updateSkyWidgets);
  </script>

  <section id="telescopes" class="border-t border-subtle mx-auto max-w-5xl px-6 py-20">
    <h2 class="section-heading">Viewing With Telescopes</h2>
    <p class="mt-4 text-ink-muted">
      Suggested targets by aperture and season, from in-town Phoenix skies (Bortle 6–8) out to dark-sky sites
      like the Antennas area (Bortle 2). Pick your aperture to see its targets.
    </p>
    <div class="mt-10 space-y-3">
      {
        telescopeTargets.map((group, index) => (
          <details class="target-group card p-0" open={index === 0}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 [&::-webkit-details-marker]:hidden">
              <span class="font-display text-lg tracking-wide text-ink-primary">{group.scope}</span>
              <svg
                class="target-chevron h-4 w-4 flex-none text-nebula-teal transition-transform"
                aria-hidden="true"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </summary>
            <dl class="space-y-3 border-t border-subtle px-5 py-4">
              {group.seasons.map((s) => (
                <div class="sm:flex sm:gap-3">
                  <dt class="flex-none font-semibold text-nebula-teal sm:w-20">{s.season}</dt>
                  <dd class="text-ink-muted">{s.text}</dd>
                </div>
              ))}
            </dl>
          </details>
        ))
      }
    </div>
  </section>

  <section id="binoculars" class="border-t border-subtle bg-space-card/40">
    <div class="mx-auto max-w-4xl px-6 py-20">
      <h2 class="section-heading">Viewable With Binoculars</h2>
      <dl class="mt-8 space-y-5">
        {
          binocularTargets.map((b) => (
            <div class="sm:flex sm:gap-3">
              <dt class="flex-none font-semibold text-nebula-teal sm:w-20">{b.season}</dt>
              <dd class="text-ink-muted">{b.text}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section id="sites" class="mx-auto max-w-5xl px-6 py-20">
    <h2 class="section-heading">Dark-Sky Observing Sites</h2>
    <p class="mt-4 text-ink-muted">
      Sites are rated on the Bortle scale, from 1 (darkest) to 9 (brightest inner-city skies).
    </p>
    <p class="mt-2 text-ink-muted">
      Want to explore more dark-sky locations beyond this list? Check out the{' '}
      <a
        href={`https://www.darkskysites.com/?lat=${astrosphericLat}&lng=${astrosphericLng}&z=8`}
        target="_blank"
        rel="noopener noreferrer"
        class="text-nebula-teal hover:underline"
      >
        light pollution map on darkskysites.com</a>.
    </p>
    <ul class="mt-8 space-y-3">
      {
        observingSites.map((site) => (
          <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b border-subtle pb-3 text-ink-muted">
            <span class="flex-none rounded-full bg-space-card px-2.5 py-0.5 text-sm font-semibold tabular-nums text-nebula-amber">
              Bortle {site.bortle}
            </span>
            <span>{site.name}</span>
            {
              site.map && (
                <a
                  href={site.map}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm font-semibold text-nebula-teal hover:underline"
                >
                  Map →
                </a>
              )
            }
          </li>
        ))
      }
    </ul>
  </section>

  <section class="border-t border-subtle">
    <div class="mx-auto max-w-3xl px-6 py-16 text-center">
      <p class="text-ink-muted">
        Want to see where the planets and spacecraft actually are right now? Explore
        <a
          href="https://eyes.nasa.gov/apps/solar-system/#/home"
          target="_blank"
          rel="noopener noreferrer"
          class="text-nebula-teal hover:underline"
        >
          NASA's Eyes on the Solar System ↗</a
        >.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* Anchor targets clear the sticky header + in-page nav when jumped to. */
  :global(#forecast),
  :global(#skychart),
  :global(#telescopes),
  :global(#binoculars),
  :global(#sites) {
    scroll-margin-top: 8rem;
  }

  .target-group[open] .target-chevron {
    transform: rotate(180deg);
  }

  /* Marks whichever meteor shower's peak is soonest — added by the client
     script above, since "soonest" depends on the visitor's actual today.
     :global() because Astro's scoped-style attribute is only ever applied
     to elements present in the server-rendered markup; this span is
     created by document.createElement at runtime, so a scoped selector
     would silently never match it. */
