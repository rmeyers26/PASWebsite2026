---
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';
import Starfield from '../components/Starfield.astro';
import { ClientRouter } from 'astro:transitions';
import Breadcrumbs from '../components/Breadcrumbs.astro';
// Self-hosted variable fonts. global.css names these families, so without the
// imports every visitor silently fell back to system-ui.
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/inter';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image = '/images/pas-logo.png' } = Astro.props;
const pageTitle = `${title} · Phoenix Astronomical Society`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);

// Plausible: cookieless, no consent banner needed. Unset in most local/dev
// builds on purpose — nothing here breaks without it, the tag is just
// omitted, same fallback pattern as ApodOfTheDay's NASA_API_KEY.
const plausibleDomain = import.meta.env.PLAUSIBLE_DOMAIN;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/images/pas-logo.png" />
    <link rel="canonical" href={canonicalURL} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:site_name" content="Phoenix Astronomical Society" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    {
      plausibleDomain && (
        <script defer data-domain={plausibleDomain} src="https://plausible.io/js/script.js" />
      )
    }
    <ClientRouter />
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded-lg focus:bg-space-base focus:px-4 focus:py-2 focus:text-ink-primary focus:outline focus:outline-2 focus:outline-nebula-teal"
    >
      Skip to content
    </a>
    <Starfield />
    <NavBar />
    <main id="main-content" tabindex="-1">
      <Breadcrumbs />
      <slot />
    </main>
    <Footer />

    <!-- Inline + data-astro-rerun so this executes again after every view
         transition; a bundled module script only ever runs once per document.
         The hidden state is applied here rather than in the stylesheet, so
         content is never hidden from visitors without JS. -->
    <script is:inline data-astro-rerun>
      (() => {
        const targets = document.querySelectorAll('main section:not([data-hero])');
        if (!targets.length) return;

        const revealAll = () => targets.forEach((el) => el.classList.add('is-revealed'));

        if (
          window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
          !('IntersectionObserver' in window)
        ) {
          revealAll();
          return;
        }

        window.__pasReveal?.disconnect();
        const observer = new IntersectionObserver(
          (entries, obs) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-revealed');
              obs.unobserve(entry.target); // reveal once, never re-hide on scroll up
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.05 },
        );
        window.__pasReveal = observer;

        targets.forEach((el) => {
          el.classList.add('reveal');
          observer.observe(el);
        });

        // Belt and braces: anything already on screen is revealed synchronously,
        // so a transition that arms the observer mid-layout can never strand
        // content at opacity 0.
        requestAnimationFrame(() => {
          targets.forEach((el) => {
            const rect = el.getBoundingClientRect();
            if (rect.top < window.innerHeight && rect.bottom > 0) {
              el.classList.add('is-revealed');
            }
          });
        });
      })();
    </script>
  </body>
</html>
