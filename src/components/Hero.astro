---
import { Image } from 'astro:assets';

interface Props {
  image: ImageMetadata | string;
  alt?: string;
  eyebrow?: string;
  title: string;
  subtitle?: string;
}

const {
  image,
  alt = 'Placeholder — real member astrophotography will replace this image',
  eyebrow,
  title,
  subtitle,
} = Astro.props;
---

<section class="relative overflow-hidden border-b border-subtle">
  {typeof image === 'string' ? (
    <img
      src={image}
      alt={alt}
      class="absolute inset-0 h-full w-full object-cover opacity-60"
      loading="eager"
    />
  ) : (
    <Image
      src={image}
      alt={alt}
      width={1600}
      class="absolute inset-0 h-full w-full object-cover opacity-60"
      loading="eager"
      fetchpriority="high"
    />
  )}
  <div class="absolute inset-0 bg-gradient-to-t from-space-base via-space-base/70 to-space-base/20"></div>
  <div class="relative mx-auto max-w-4xl px-6 py-32 text-center sm:py-40">
    {eyebrow && (
      <span class="glass-badge mb-6" data-hero-item>
        <span class="h-1.5 w-1.5 rounded-full bg-nebula-teal shadow-glow-teal" />
        {eyebrow}
      </span>
    )}
    <h1 class="text-gradient font-display text-4xl leading-[1.05] tracking-tight sm:text-7xl" data-hero-item>{title}</h1>
    {subtitle && <p class="mx-auto mt-7 max-w-2xl text-lg leading-relaxed text-ink-muted" data-hero-item>{subtitle}</p>}
    <div data-hero-item><slot /></div>
  </div>
</section>
