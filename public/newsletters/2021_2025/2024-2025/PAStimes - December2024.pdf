201 0 obj
<<
/Type /StructElem
/S /P
/ActualText (New development in the field of adaptive optics \(AO\))
/Pg 9 0 R
/K [1]
>>
endobj
202 0 obj
<<
/Type /StructElem
/S /P
/ActualText (Dr. Al Conrad)
/Pg 9 0 R
/K [2]
>>
endobj
203 0 obj
<<
