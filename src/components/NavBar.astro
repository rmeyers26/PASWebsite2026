---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import pasLogo from '../assets/images/pas-logo.png';

type NavLink = { href: string; label: string };
type NavItem = { label: string; href?: string; children?: NavLink[] };

// Same source as the home page's Special Interest Groups section — an
// officer disabling a group here via the CMS removes it from the nav too.
const groupLinks: NavLink[] = (await getCollection('special-interest-groups'))
  .filter((group) => group.data.enabled)
  .sort((a, b) => a.data.order - b.data.order)
  .map((group) => ({ href: group.data.url, label: group.data.abbr }));

// Seven top-level entries (six here plus the Join CTA). Grouping keeps the
// secondary reference pages reachable without competing with Events, Gallery,
// and Join, and gives /history and /leadership a home in the primary nav.
const navItems: NavItem[] = [
  {
    label: 'About',
    children: [
      { href: '/about', label: 'About PAS' },
      { href: '/history', label: 'History' },
      { href: '/leadership', label: 'Club Leadership' },
      { href: '/newsletters', label: 'Newsletters' },
      { href: '/press-releases', label: 'Press Releases' },
      { href: '/scholarship', label: 'Scholarship Fund' },
      { href: '/contact', label: 'Contact' },
    ],
  },
  { label: 'Events', href: '/events' },
  { label: 'Previous Lectures', href: '/lecture-videos' },
  { label: 'Gallery', href: '/gallery' },
  {
    label: 'Outreach',
    children: [
      { href: '/star-tours', label: 'Star Tours' },
      { href: '/telescope-workshops', label: 'Telescope Workshops' },
      { href: '/loaner-scopes', label: 'Telescope Loan Program' },
    ],
  },
  {
    label: 'Learn',
    children: [
      { href: '/learn', label: 'Learn Astronomy' },
      { href: '/sky-conditions', label: 'Sky Conditions' },
      { href: '/exoplanets', label: 'Exoplanets' },
    ],
  },
  ...(groupLinks.length > 0
    ? [{ label: 'Special Interest Groups (SIG)', children: groupLinks }]
    : []),
];

// Astro's static build serves subpages with a trailing slash (/events/), so
// strip it before comparing against the slash-free hrefs above — otherwise no
// nav item is ever marked active outside the homepage.
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (item: NavItem) =>
  item.href === currentPath ||
  (item.children?.some((child) => child.href === currentPath) ?? false);
---

<header class="sticky top-0 z-50 border-b border-subtle bg-space-base/80 backdrop-blur-2xl">
  <nav
    class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-6 py-4"
    aria-label="Primary"
  >
    <a
      href="/"
      class="flex flex-none items-center gap-2.5 font-display text-base tracking-tight text-ink-primary"
      aria-current={currentPath === '/' ? 'page' : undefined}
    >
      <Image
        src={pasLogo}
        alt="Phoenix Astronomical Society logo"
        width={72}
        height={72}
        loading="eager"
        fetchpriority="high"
        class="size-9 flex-none"
      />
      <span class="hidden whitespace-nowrap sm:inline">Phoenix Astronomical Society</span>
      <span class="sm:hidden">PAS</span>
    </a>

    <ul class="hidden items-center gap-2 lg:flex">
      {
        navItems.map((item) =>
          item.children ? (
            <li class="relative">
              <details class="nav-disclosure">
                <summary
                  class:list={[
                    'flex cursor-pointer list-none items-center gap-1.5 whitespace-nowrap rounded-full px-3 py-2 text-sm font-medium transition hover:text-nebula-teal [&::-webkit-details-marker]:hidden',
                    isActive(item) ? 'text-nebula-teal' : 'text-ink-primary',
                  ]}
                  aria-expanded="false"
                >
                  {item.label}
                  <svg
                    class="nav-chevron size-3.5 transition-transform"
                    aria-hidden="true"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <polyline points="6 9 12 15 18 9" />
                  </svg>
                </summary>
                <ul class="nav-panel absolute top-full left-0 z-10 mt-2 min-w-56 rounded-2xl border border-subtle bg-space-modal p-2 shadow-2xl">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        class:list={[
                          'block whitespace-nowrap rounded-xl px-3 py-2 text-sm transition hover:bg-white/5 hover:text-nebula-teal',
                          child.href === currentPath ? 'text-nebula-teal' : 'text-ink-primary',
                        ]}
                        aria-current={child.href === currentPath ? 'page' : undefined}
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            </li>
          ) : (
            <li>
              <a
                href={item.href}
                class:list={[
                  'block whitespace-nowrap rounded-full px-3 py-2 text-sm font-medium transition hover:text-nebula-teal',
                  isActive(item) ? 'text-nebula-teal' : 'text-ink-primary',
                ]}
                aria-current={isActive(item) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          )
        )
      }
    </ul>

    <button
      type="button"
      id="site-search-trigger"
      class="flex size-11 flex-none items-center justify-center rounded-full text-ink-primary transition hover:text-nebula-teal"
      aria-label="Search the site"
    >
      <svg
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="11" cy="11" r="7"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
    </button>

    <a
      href="/join"
      class="btn-primary hidden flex-none px-5 py-2.5 text-sm whitespace-nowrap lg:inline-flex"
      aria-current={currentPath === '/join' ? 'page' : undefined}
    >
      Join PAS
    </a>

    <details class="mobile-menu nav-disclosure lg:hidden">
      <summary
        class="flex size-11 cursor-pointer list-none items-center justify-center rounded-full text-ink-primary transition hover:text-nebula-teal [&::-webkit-details-marker]:hidden"
        aria-label="Open menu"
        aria-expanded="false"
      >
        <svg
          class="menu-icon-open"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="4" y1="6" x2="20" y2="6"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="18" x2="20" y2="18"></line>
        </svg>
        <svg
          class="menu-icon-close"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="6" y1="6" x2="18" y2="18"></line>
          <line x1="18" y1="6" x2="6" y2="18"></line>
        </svg>
      </summary>

      <div
        class="nav-panel absolute inset-x-4 top-full mt-2 max-h-[calc(100vh-6rem)] overflow-y-auto rounded-2xl border border-subtle bg-space-modal px-5 py-4 shadow-2xl"
      >
        <ul class="flex flex-col gap-1">
          {
            navItems.map((item) =>
              item.children ? (
                <li class="mt-2 first:mt-0">
                  <p class="px-1 pb-1 font-display text-lg font-bold text-nebula-amber">
                    {item.label}
                  </p>
                  <ul>
                    {item.children.map((child) => (
                      <li>
                        <a
                          href={child.href}
                          class:list={[
                            'block rounded-xl px-3 py-2.5 transition hover:bg-white/5',
                            child.href === currentPath ? 'text-nebula-teal' : 'text-ink-primary',
                          ]}
                          aria-current={child.href === currentPath ? 'page' : undefined}
                        >
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </li>
              ) : (
                <li class="mt-2 first:mt-0">
                  <a
                    href={item.href}
                    class:list={[
                      'block rounded-xl px-3 py-2.5 font-display text-lg font-bold transition hover:bg-white/5',
                      isActive(item) ? 'text-nebula-teal' : 'text-nebula-amber',
                    ]}
                    aria-current={isActive(item) ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              )
            )
          }
        </ul>
        <a href="/join" class="btn-primary mt-5 w-full">Join PAS</a>
      </div>
    </details>
  </nav>

  <dialog id="site-search-dialog" class="site-search-dialog" aria-label="Search the site">
    <div class="site-search-dialog-inner">
      <button
        type="button"
        id="site-search-close"
        class="site-search-close"
        aria-label="Close search"
      >
        <svg
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="6" y1="6" x2="18" y2="18"></line>
          <line x1="18" y1="6" x2="6" y2="18"></line>
        </svg>
      </button>
      <div id="site-search-results"></div>
    </div>
  </dialog>
</header>

<style>
  /* <details> gives keyboard support and a working menu with no JS; the script
     below only layers on the behaviours it lacks. Entry is animated here because
     the closed state is display:none, which cannot be transitioned. */
  .nav-panel {
    animation: nav-panel-in 0.16s ease-out;
    transform-origin: top;
  }

  @keyframes nav-panel-in {
    from {
      opacity: 0;
      transform: translateY(-0.35rem) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .nav-disclosure[open] .nav-chevron {
    transform: rotate(180deg);
  }

  .menu-icon-close {
    display: none;
  }

  .mobile-menu[open] .menu-icon-open {
    display: none;
  }

  .mobile-menu[open] .menu-icon-close {
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-panel {
      animation: none;
    }

    .nav-chevron {
      transition: none;
    }
  }

  .site-search-dialog {
    width: min(640px, calc(100vw - 2rem));
    max-height: min(32rem, calc(100vh - 6rem));
    margin: 4rem auto auto;
    border: 1px solid var(--color-border-subtle, #3a3a4a);
    border-radius: 1rem;
    background-color: var(--color-space-modal, #18233d);
    padding: 0;
    color: inherit;
  }

  .site-search-dialog-inner {
    position: relative;
    max-height: min(32rem, calc(100vh - 6rem));
    overflow-y: auto;
    padding: 1.25rem;
  }

  .site-search-close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    display: flex;
    height: 2.25rem;
    width: 2.25rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    color: var(--color-ink-muted, #9ba3b7);
    transition: color 0.15s ease;
  }

  .site-search-close:hover {
    color: var(--color-nebula-teal, #2dd4bf);
  }
</style>

<style is:global>
  .site-search-dialog::backdrop {
    background-color: rgba(10, 14, 23, 0.7);
    backdrop-filter: blur(2px);
  }

  /* Theme the Pagefind UI widget (injected at runtime into #site-search-results
     by src/scripts/site-search.ts) to match the site's dark palette instead of
     its light-mode default — see https://pagefind.app/docs/ui/#styling-search */
  #site-search-results {
    --pagefind-ui-scale: 0.92;
    --pagefind-ui-primary: var(--color-nebula-teal, #2dd4bf);
    --pagefind-ui-text: var(--color-ink-primary, #f1f3f8);
    --pagefind-ui-background: var(--color-space-modal, #18233d);
    --pagefind-ui-border: var(--color-border-subtle, #3a3a4a);
    --pagefind-ui-tag: var(--color-space-card, #12182b);
    --pagefind-ui-font: inherit;
    padding-right: 2rem;
  }
</style>

<script>
  import { initNavDisclosures } from '../scripts/nav-disclosures';
  import { initSiteSearch } from '../scripts/site-search';
  initNavDisclosures();
  initSiteSearch();
</script>
