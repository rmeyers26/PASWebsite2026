---
import { Image } from 'astro:assets';

// A full-bleed image/text split — the site's one alternative to the card
// grid used everywhere else below the fold. Reserved for a section that
// earns a large photograph, not a default for every section: overusing this
// would just trade one monotonous pattern for another.
interface Props {
  image: ImageMetadata;
  alt: string;
  eyebrow?: string;
  title: string;
  /** Puts the image on the right instead of the left, so two instances in a
   *  row don't read as a repeating stripe. */
  reverse?: boolean;
}

const { image, alt, eyebrow, title, reverse = false } = Astro.props;
---

<section class="border-t border-subtle">
  <div class="grid lg:grid-cols-2">
    <div
      class:list={[
        'relative min-h-[20rem] lg:min-h-[28rem]',
        reverse ? 'lg:order-2' : 'lg:order-1',
      ]}
    >
      <Image
        src={image}
        alt={alt}
        widths={[480, 800, 1200]}
        sizes="(min-width: 1024px) 50vw, 100vw"
        loading="lazy"
        class="absolute inset-0 size-full object-cover"
      />
    </div>
    <div
      class:list={[
        'flex flex-col justify-center px-6 py-16 sm:px-12 sm:py-20 lg:px-16',
        reverse ? 'lg:order-1' : 'lg:order-2',
      ]}
    >
      {
        eyebrow && (
          <span class="glass-badge mb-6 self-start">
            <span class="size-1.5 rounded-full bg-nebula-teal shadow-glow-teal" />
            {eyebrow}
          </span>
        )
      }
      <h2 class="section-heading">{title}</h2>
      <div class="mt-4 space-y-4 text-ink-muted">
        <slot />
      </div>
    </div>
  </div>
</section>
