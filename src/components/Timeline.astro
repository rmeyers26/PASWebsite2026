---
interface TimelineEntry {
  date: string;
  organization?: string;
  location?: string;
  notes: string;
}

interface Props {
  entries: TimelineEntry[];
}

const { entries } = Astro.props;
---

<ol class="relative border-l border-subtle pl-8">
  {
    entries.map((entry) => (
      <li class="mb-10 last:mb-0">
        <span class="absolute left-[-7px] mt-1.5 size-3 rounded-full bg-nebula-teal shadow-glow-teal" />
        <p class="font-display text-xl text-nebula-amber">{entry.date}</p>
        {(entry.organization || entry.location) && (
          <p class="mt-1 text-sm text-ink-muted">
            {entry.organization}
            {entry.organization && entry.location && ' · '}
            {entry.location}
          </p>
        )}
        <p class="mt-2 text-ink-muted">{entry.notes}</p>
      </li>
    ))
  }
</ol>
