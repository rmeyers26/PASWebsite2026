---
// A lightweight animated hero for pages without real photography yet: a two-layer CSS
// starfield (same build-time box-shadow technique as Starfield.astro, zero client JS for
// the stars themselves) over a tinted radial-gradient backdrop, plus one small
// vanilla-JS-driven shooting star. No three.js — this is a background decoration, not a
// scene, so it should cost close to nothing.
import { makeLayer } from '../lib/starLayer';

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  accent?: 'violet' | 'teal' | 'amber';
}

const { eyebrow, title, subtitle, accent = 'violet' } = Astro.props;

const accentColors: Record<string, string> = {
  violet: 'rgba(139, 92, 246, 0.28)',
  teal: 'rgba(45, 212, 191, 0.24)',
  amber: 'rgba(245, 185, 66, 0.22)',
};
const accentColor = accentColors[accent];

const farStars = makeLayer(90, 0.5);
const nearStars = makeLayer(40, 0.85);
---

<section class="relative isolate flex min-h-[60vh] items-center overflow-hidden border-b border-subtle bg-space-base">
  <div
    class="absolute inset-0"
    style={`background: radial-gradient(65% 55% at 78% 15%, ${accentColor}, transparent 60%), radial-gradient(50% 45% at 15% 85%, rgba(45, 212, 191, 0.14), transparent 60%), #0a0e17;`}
    aria-hidden="true"
  >
  </div>
  <div
    class="ambient-hero-far absolute h-px w-px rounded-full"
    style={`box-shadow: ${farStars};`}
    aria-hidden="true"
  >
  </div>
  <div
    class="ambient-hero-near absolute h-[1.5px] w-[1.5px] rounded-full"
    style={`box-shadow: ${nearStars};`}
    aria-hidden="true"
  >
  </div>
  <div class="ambient-hero-shooting-star" aria-hidden="true"></div>
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-space-base via-space-base/10 to-transparent">
  </div>
  <div class="relative mx-auto max-w-4xl px-6 py-24 text-center sm:py-32">
    {
      eyebrow && (
        <span class="glass-badge mb-6">
          <span class="h-1.5 w-1.5 rounded-full bg-nebula-teal shadow-glow-teal" />
          {eyebrow}
        </span>
      )
    }
    <h1 class="text-gradient font-display text-4xl leading-[1.05] tracking-tight sm:text-6xl">{title}</h1>
    {subtitle && <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-ink-muted">{subtitle}</p>}
    <slot />
  </div>
</section>

<style>
  .ambient-hero-far,
  .ambient-hero-near {
    animation: ambient-hero-twinkle 5s ease-in-out infinite;
  }

  .ambient-hero-near {
    animation-duration: 3.5s;
    animation-direction: reverse;
  }

  @keyframes ambient-hero-twinkle {
    0%,
    100% {
      opacity: 0.65;
    }
    50% {
      opacity: 1;
    }
  }

  .ambient-hero-shooting-star {
    position: absolute;
    top: 18%;
    left: -10%;
    width: 3px;
    height: 3px;
    border-radius: 999px;
    background: #f1f3f8;
    box-shadow: 0 0 6px 1px rgba(241, 243, 248, 0.8);
    opacity: 0;
  }

  .ambient-hero-shooting-star.fire {
    animation: ambient-hero-shoot 1.1s ease-out;
  }

  @keyframes ambient-hero-shoot {
    0% {
      opacity: 0;
      transform: translate(0, 0) rotate(28deg) scaleX(1);
    }
    12% {
      opacity: 1;
    }
    75% {
      opacity: 0.9;
    }
    100% {
      opacity: 0;
      transform: translate(65vw, 34vh) rotate(28deg) scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ambient-hero-far,
    .ambient-hero-near {
      animation: none;
    }
  }
</style>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefersReducedMotion) {
    document.querySelectorAll<HTMLElement>('.ambient-hero-shooting-star').forEach((star) => {
      function fire() {
        star.classList.remove('fire');
        // Force a reflow so re-adding the class restarts the CSS animation.
        void star.offsetWidth;
        star.classList.add('fire');
        setTimeout(fire, 6000 + Math.random() * 8000);
      }
      setTimeout(fire, 2000 + Math.random() * 3000);
    });
  }
</script>
