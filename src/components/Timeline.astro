---
interface TimelineEntry {
  date: string;
  organization?: string;
  location?: string;
  notes: string;
}

interface Props {
  entries: TimelineEntry[];
}

const { entries } = Astro.props;
---

<ol class="relative pl-8" data-timeline>
  <span class="absolute left-0 top-0 h-full w-px bg-subtle" aria-hidden="true" />
  <span
    class="absolute left-0 top-0 h-full w-px origin-top bg-nebula-teal shadow-glow-teal"
    data-timeline-line
    aria-hidden="true"
  />
  {
    entries.map((entry) => (
      <li class="relative mb-10 last:mb-0" data-animate="fade-up" data-animate-group="timeline">
        <span class="absolute -left-[7px] mt-1.5 h-3 w-3 rounded-full bg-nebula-teal shadow-glow-teal" />
        <p class="font-display text-xl text-nebula-amber">{entry.date}</p>
        {(entry.organization || entry.location) && (
          <p class="mt-1 text-sm text-ink-muted">
            {entry.organization}
            {entry.organization && entry.location && ' · '}
            {entry.location}
          </p>
        )}
        <p class="mt-2 text-ink-muted">{entry.notes}</p>
      </li>
    ))
  }
</ol>
