---
import { Image } from 'astro:assets';

interface Photo {
  src: ImageMetadata;
  alt: string;
  caption: string;
  color?: boolean;
}

interface Props {
  photos: Photo[];
}

const { photos } = Astro.props;
---

<div class="grid gap-6 sm:grid-cols-2">
  {
    photos.map((photo) => (
      <figure
        class="overflow-hidden rounded-xl border border-subtle bg-space-card"
        data-animate="fade-scale"
        data-animate-group="photogrid"
      >
        <Image
          src={photo.src}
          alt={photo.alt}
          width={800}
          loading="lazy"
          class:list={['h-56 w-full object-cover', !photo.color && 'grayscale']}
        />
        <figcaption class="px-4 py-3 text-sm text-ink-muted">{photo.caption}</figcaption>
      </figure>
    ))
  }
</div>
