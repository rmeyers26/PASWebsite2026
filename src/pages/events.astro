---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import PlaceholderNote from '../components/PlaceholderNote.astro';
import fireworksTelescope from '../assets/images/events-fireworks-telescope.jpg';
import lectureMeeting from '../assets/images/events-lecture-meeting.jpg';
import lowellObservatoryTour from '../assets/images/events-lowell-observatory-tour.jpg';
---

<BaseLayout
  title="Events"
  description="Upcoming PAS meetings, public star parties, and observing nights in the Phoenix area."
>
  <Hero
    image={fireworksTelescope}
    alt="A PAS telescope set up beside a fireworks display at a public event"
    eyebrow="Events"
    title="When Is the Next Observing Session?"
    subtitle="Public star parties, monthly meetings, and special events — all in one place."
    tone="dark"
    focalPoint="50% 30%"
  />

  <section class="mx-auto max-w-4xl px-6 py-20">
    <h2 class="section-heading">Upcoming Events</h2>
    <p class="mt-4 text-ink-muted">
      Our full events calendar — meetings, public star parties, and observing nights — is kept up to date on
      Bookwhen. Browse and reserve a spot below, or{' '}
      <a href="https://bookwhen.com/pas-event-calendar#focus=ev-s4pyi-20260701000000" target="_blank" rel="noopener noreferrer" class="underline decoration-nebula-teal underline-offset-4">
        open the calendar in a new tab</a>.
    </p>
    <figure class="mt-8 overflow-hidden rounded-xl border border-subtle bg-space-card">
      <Image
        src={lectureMeeting}
        alt="PAS members sharing a meal before the monthly Lecture Series meeting, screens showing the meeting agenda"
        width={1000}
        class="w-full object-cover"
        loading="lazy"
      />
      <figcaption class="px-4 py-3 text-sm text-ink-muted">
        Members gather before a monthly Lecture Series meeting.
      </figcaption>
    </figure>
    <div class="mt-8 overflow-hidden rounded-lg border border-subtle">
      <iframe
        src="https://bookwhen.com/pas-event-calendar/iframe#focus=ev-s4pyi-20260701000000"
        title="PAS Events Calendar"
        class="block min-h-[400px] w-full border-0"
        loading="lazy"
      ></iframe>
    </div>
    <script is:inline src="https://cdn.bookwhen.com/js/iframe_resizer.js"></script>
  </section>

  <section class="border-t border-subtle">
    <div class="mx-auto max-w-4xl px-6 py-20">
      <h2 class="section-heading">Where We Meet</h2>

      <h3 class="font-display mt-8 text-lg text-nebula-teal">Monthly Lecture Series</h3>
      <p class="mt-3 text-ink-muted">
        Held on the <strong class="font-semibold text-ink-primary">1st Thursday of every month</strong> at
        Paradise Valley Community College:
      </p>
      <address class="mt-4 not-italic text-ink-primary">
        PVCC Building Q — Conference Center, Classroom 120A<br />
        17811 North 32nd Street<br />
        Phoenix, AZ 85032
      </address>
      <div class="mt-6 overflow-hidden rounded-lg border border-subtle">
        <iframe
          src="https://maps.google.com/maps?q=17811+North+32nd+Street,+Phoenix,+AZ+85032&output=embed"
          title="Map showing PVCC Building Q, 17811 North 32nd Street, Phoenix, AZ 85032"
          class="block h-[320px] w-full border-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>

      <h3 class="font-display mt-12 text-lg text-nebula-violet">Public Star Parties</h3>
      <p class="mt-3 text-ink-muted">Held at Apache Wash Trailhead, away from city light pollution:</p>
      <address class="mt-4 not-italic text-ink-primary">
        Apache Wash Trailhead<br />
        1600 E Sonoran Desert Dr<br />
        Phoenix, AZ 85085
      </address>
      <p class="mt-4 text-sm text-ink-muted">
        Check each star party on the calendar above for its exact date and time.
      </p>
      <div class="mt-6 overflow-hidden rounded-lg border border-subtle">
        <iframe
          src="https://maps.google.com/maps?q=Apache+Wash+Trailhead,+1600+E+Sonoran+Desert+Dr,+Phoenix,+AZ+85085&output=embed"
          title="Map showing Apache Wash Trailhead, 1600 E Sonoran Desert Dr, Phoenix, AZ 85085"
          class="block h-[320px] w-full border-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </section>

  <section class="border-t border-subtle bg-space-card/40">
    <div class="mx-auto max-w-4xl px-6 py-20">
      <h2 class="section-heading">What to Bring</h2>
      <ul class="mt-6 space-y-3 text-ink-muted">
        <li>• A red flashlight (preserves night vision — white light is discouraged at star parties)</li>
        <li>• Warm layers — desert nights get cold, even in summer</li>
        <li>• A folding chair for comfortable viewing</li>
        <li>• Your own telescope or binoculars, if you have them — not required, PAS members bring plenty</li>
      </ul>
    </div>
  </section>

  <section class="border-t border-subtle bg-space-card/40">
    <div class="mx-auto max-w-4xl px-6 py-20">
      <h2 class="section-heading">Telescope Workshops</h2>
      <p class="mt-4 text-ink-muted">
        Can't find anything in your telescope, or need help picking one out? PAS members run free, public
        telescope workshops throughout the year.
      </p>
      <a href="/telescope-workshops" class="btn-secondary mt-6">Learn More</a>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-6 py-20">
    <h2 class="section-heading">Special Events</h2>
    <p class="mt-4 text-ink-muted">
      Beyond our regular meetings and star parties, PAS members take part in special trips and events throughout
      the year — like a private group tour of Lowell Observatory's Richard F. Caris Dark Sky Planetarium in
      Flagstaff.
    </p>
    <figure class="mt-8 overflow-hidden rounded-xl border border-subtle bg-space-card">
      <Image
        src={lowellObservatoryTour}
        alt="PAS members on a private tour of Lowell Observatory's Richard F. Caris Dark Sky Planetarium rooftop deck"
        width={1000}
        loading="lazy"
        class="w-full object-cover"
      />
      <figcaption class="px-4 py-3 text-sm text-ink-muted">
        PAS members on a private tour of Lowell Observatory's Dark Sky Planetarium.
      </figcaption>
    </figure>
  </section>

  <section class="border-t border-subtle bg-space-card/40">
    <div class="mx-auto max-w-4xl px-6 py-20">
      <h2 class="section-heading">School & Scout Group Visits</h2>
      <p class="mt-4 text-ink-muted">
        PAS brings telescopes and presenters to schools, scout troops, and community organizations for hands-on
        astronomy outreach, through our Star Tours program.
      </p>
      <div class="mt-6">
        <PlaceholderNote label="A self-serve online request form is planned for a future phase. Until then, Star Tours events are booked by email." />
      </div>
      <a href="/star-tours" class="btn-secondary mt-6">See Star Tours Details</a>
    </div>
  </section>
</BaseLayout>
