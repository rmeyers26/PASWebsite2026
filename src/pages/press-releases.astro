  { date: '2023-08-18', file: '/press-releases/2023/2023-08-18-press-release.pdf' },
  { date: '2023-07-14', file: '/press-releases/2023/2023-07-14-press-release.pdf' },
  { date: '2023-05-04', file: '/press-releases/2023/2023-05-04-press-release.pdf' },
  { date: '2023-02-23', file: '/press-releases/2023/2023-02-23-press-release.pdf' },
