---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import PlaceholderNote from '../components/PlaceholderNote.astro';
---

<BaseLayout
  title="About"
  description="The history, mission, and people behind the Phoenix Astronomical Society."
>
  <Hero
    image="/images/placeholder-hero-about.svg"
    eyebrow="About PAS"
    title="A Community of Stargazers Since 1948"
    subtitle="Amateur and professional astronomers, teachers and learners, oldsters and youngsters — all inquiring minds."
  />

  <section class="mx-auto max-w-4xl px-6 py-20">
    <h2 class="section-heading">Our Mission</h2>
    <p class="mt-4 text-ink-muted">
      The Phoenix Astronomical Society is a 501(c)(3) nonprofit organization dedicated to sharing the night sky
      with the Phoenix community — through public star parties, school and scout outreach, and a welcoming home
      for anyone curious about the universe, from lifelong amateur astronomers to first-time stargazers. PAS is
      also a Night Sky Network member organization, a NASA-affiliated program run by the Astronomical Society of
      the Pacific to bring the wonders of the universe to the public.
    </p>
  </section>

  <section class="border-t border-subtle bg-space-card/40">
    <div class="mx-auto max-w-4xl px-6 py-20">
      <h2 class="section-heading">Our History</h2>
      <p class="mt-4 text-ink-muted">
        Founded in 1948 as the Phoenix Observatory Association by Phoenix College physics professor Amos Hoff,
        PAS spent its early decades pursuing an ambitious dream: building a public observatory. That project was
        never completed, but the society it created has endured — through Phoenix College, Brophy College Prep,
        Valley Academy, Foothills Academy, and, since 2005, Paradise Valley Community College, where PAS holds
        public star parties today at the automated observatory on the Black Mountain campus.
      </p>
      <a href="/history" class="btn-secondary mt-6">Read the Full History</a>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-6 py-20">
    <h2 class="section-heading">Club Leadership</h2>
    <p class="mt-4 text-ink-muted">
      PAS is run entirely by volunteer members, including officers overseeing membership, events, and community
      outreach. Mike Marron is our current president.
    </p>
    <figure class="mt-8 overflow-hidden rounded-xl border border-subtle bg-space-card">
      <img
        src="/images/about-officer-award-telescope.jpg"
        alt="A PAS officer presenting another member with a FirstScope Moon telescope, with outreach event photos on screen behind them"
        loading="lazy"
        class="w-full object-cover"
      />
      <figcaption class="px-4 py-3 text-sm text-ink-muted">
        PAS officers recognize member contributions at club meetings.
      </figcaption>
    </figure>
    <div class="mt-6">
      <PlaceholderNote label="Full current officer roster (Secretary, Events, Membership, Star Tours, etc.) and bios go here — placeholder until confirmed by the club, beyond the current president noted above." />
    </div>
  </section>

  <section class="border-t border-subtle">
    <div class="mx-auto max-w-4xl px-6 py-20">
      <h2 class="section-heading">Our Observing Site</h2>
      <p class="mt-4 text-ink-muted">
        PAS members observe from dark-sky sites around the Phoenix area, away from city light pollution.
      </p>
      <div class="mt-6">
        <PlaceholderNote label="Specific site name, directions, and facility details (this is a strong candidate for its own page, per the full site plan) go here once confirmed." />
      </div>
    </div>
  </section>
</BaseLayout>
