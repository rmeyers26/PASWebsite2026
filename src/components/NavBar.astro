---
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/events', label: 'Events' },
  { href: '/star-tours', label: 'Star Tours', highlight: true },
  { href: '/telescope-workshops', label: 'Telescope Workshops' },
  { href: '/sky-conditions', label: 'Sky Conditions' },
  { href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-subtle bg-space-base/60 backdrop-blur-2xl">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4" aria-label="Primary">
    <a href="/" class="flex items-center gap-2.5 font-display text-lg tracking-tight text-ink-primary">
      <img src="/images/pas-logo.png" alt="Phoenix Astronomical Society logo" class="h-9 w-9 flex-none" />
      <span class="hidden sm:inline">Phoenix Astronomical Society</span>
      <span class="sm:hidden">PAS</span>
    </a>
    <ul class="hidden gap-6 lg:flex">
      {
        navItems.map((item) => {
          const isActive = currentPath === item.href;
          return (
            <li>
              <a
                href={item.href}
                class:list={
                  item.highlight
                    ? ['text-base font-bold tracking-wide text-nebula-amber transition hover:text-nebula-amber/80']
                    : [
                        'text-sm font-medium transition hover:text-nebula-teal',
                        isActive ? 'text-nebula-teal' : 'text-ink-primary',
                      ]
                }
                aria-current={isActive ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })
      }
    </ul>
    <a href="/join" class="btn-primary hidden text-sm lg:inline-flex">Join PAS</a>
    <details class="lg:hidden">
      <summary
        class="flex h-11 w-11 cursor-pointer list-none items-center justify-center text-2xl text-ink-primary"
        aria-label="Open menu"
      >
        ☰
      </summary>
      <ul class="glass-panel absolute left-4 right-4 top-full mt-2 flex flex-col gap-1 px-6 py-4">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  'block py-2',
                  item.highlight ? 'font-bold text-nebula-amber' : 'text-ink-primary',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href="/join" class="mt-2 block py-2 font-semibold text-nebula-teal">
            Join PAS
          </a>
        </li>
      </ul>
    </details>
  </nav>
</header>
