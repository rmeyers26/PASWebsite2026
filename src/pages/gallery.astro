---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';

// Content lives in src/content/gallery/ (one JSON file per photo, managed via
// the Sveltia CMS) — see src/content.config.ts for the schema. Curated
// images keep living in src/assets/images/gallery/ and are referenced by
// relative path so they still go through Astro's <Image> optimization
// pipeline; new CMS uploads land in public/ instead (see PLAN.md /
// src/content.config.ts comments — hybrid strategy, confirmed decision).
//
// Each image keeps its own aspect ratio rather than being cropped into a
// uniform grid — a 3:1 Milky Way panorama and a near-square nebula shot
// would fight a fixed-height treatment, and these are the club's best work,
// not archival thumbnails (see PhotoGrid for that treatment on /history).
const galleryEntries = await getCollection('gallery');
const allPhotos = galleryEntries
  .sort((a, b) => a.data.order - b.data.order)
  // `photo` (CMS upload) wins over `image` (developer-curated) when both
  // are somehow set; entries missing both are dropped rather than crashing.
  .flatMap((entry) => {
    const src = entry.data.photo ?? entry.data.image;
    return src
      ? [
          {
            src,
            alt: entry.data.alt,
            photographer: entry.data.photographer,
            subject: entry.data.subject,
            note: entry.data.note,
            category: entry.data.category,
          },
        ]
      : [];
  });
// Astrophotography is the gallery's main draw and stays the primary section;
// club-event snapshots (giveaways, guest speakers, star parties) get their
// own section below rather than being interleaved by `order`.
const photos = allPhotos.filter((photo) => photo.category === 'astrophoto');
const eventPhotos = allPhotos.filter((photo) => photo.category === 'event');
// Gallery entries are CMS-editable now, so an all-deleted collection is a
// real (if unlikely) state to handle, not a hypothetical.
const firstPhoto = allPhotos.at(0);
---

<BaseLayout
  title="Member Gallery"
  description="Astrophotography from Phoenix Astronomical Society members — the Milky Way, nebulae, and the Sun, captured from Arizona skies."
>
  <Hero
    image={firstPhoto?.src ?? '/images/pas-logo.png'}
    alt={firstPhoto?.alt ?? 'Phoenix Astronomical Society'}
    eyebrow="Member Gallery"
    title="What Our Members See"
    subtitle="Astrophotography by PAS members, captured from Phoenix-area skies and beyond."
    tone="dark"
    focalPoint="50% 40%"
  />

  <!-- Two sections is enough to make jumping past 14+ astrophotos to reach
       the club-event snapshots (or back) worth a shortcut. Matches the
       in-page nav pattern on /sky-conditions: sticky directly beneath the
       site header, horizontally scrollable so it never wraps on mobile. -->
  {
    eventPhotos.length > 0 && (
      <nav
        aria-label="On this page"
        class="sticky top-17 z-30 border-b border-subtle bg-space-base/90 backdrop-blur-xl"
      >
        <ul class="mx-auto flex max-w-5xl gap-6 overflow-x-auto px-6 py-3 text-sm whitespace-nowrap">
          <li>
            <a href="#member-images" class="text-ink-muted transition hover:text-nebula-teal">
              Member Images
            </a>
          </li>
          <li>
            <a href="#club-events" class="text-ink-muted transition hover:text-nebula-teal">
              Club Events
            </a>
          </li>
        </ul>
      </nav>
    )
  }

  <section class="mx-auto max-w-3xl px-6 py-8 text-center">
    <p class="text-ink-muted">
      Want to learn how it's done?{' '}
      <a href="/asig" class="text-nebula-teal hover:underline">Join ASIG</a>.
    </p>
  </section>

  <section id="member-images" class="scroll-mt-32 border-t border-subtle">
    <div class="mx-auto max-w-4xl px-6 py-16">
      {
        photos.length === 0 ? (
          <p class="text-center text-ink-muted">
            No photos here yet — check back soon, or see{' '}
            <a href="/contact" class="text-nebula-teal hover:underline">
              how to submit one
            </a>
            .
          </p>
        ) : (
          <div class="space-y-16">
            {photos.map((photo) => (
              <figure class="overflow-hidden rounded-2xl border border-subtle bg-space-card">
                <button
                  type="button"
                  class="gallery-photo-trigger block w-full cursor-zoom-in"
                  aria-label={`View ${photo.subject} full size`}
                >
                  {typeof photo.src === 'string' ? (
                    // CMS-uploaded photos land in public/ as a plain URL, which
                    // bypasses Astro's asset pipeline — <Image> can't process
                    // these, so they render unoptimized (see hybrid gallery
                    // strategy in src/content.config.ts).
                    <img src={photo.src} alt={photo.alt} loading="lazy" class="w-full" />
                  ) : (
                    <Image
                      src={photo.src}
                      alt={photo.alt}
                      width={1600}
                      widths={[640, 1080, 1600]}
                      sizes="(min-width: 896px) 850px, 100vw"
                      quality={80}
                      loading="lazy"
                      class="w-full"
                    />
                  )}
                </button>
                <figcaption class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 px-6 py-5">
                  <div>
                    <p data-lightbox="subject" class="font-display text-lg text-nebula-teal">
                      {photo.subject}
                    </p>
                    <p data-lightbox="note" class="mt-1 text-sm text-ink-muted">
                      {photo.note}
                    </p>
                  </div>
                  <p
                    data-lightbox="photographer"
                    class="flex-none text-sm font-semibold text-ink-primary"
                  >
                    © {photo.photographer}
                  </p>
                </figcaption>
              </figure>
            ))}
          </div>
        )
      }
    </div>
  </section>

  {
    eventPhotos.length > 0 && (
      <section id="club-events" class="scroll-mt-32 border-t border-subtle">
        <div class="mx-auto max-w-4xl px-6 py-16">
          <h2 class="section-heading text-center">Club Events</h2>
          <p class="mx-auto mt-4 max-w-xl text-center text-ink-muted">
            Star parties, guest speakers, and other moments from PAS gatherings.
          </p>
          <div class="mt-12 space-y-16">
            {eventPhotos.map((photo) => (
              <figure class="overflow-hidden rounded-2xl border border-subtle bg-space-card">
                <button
                  type="button"
                  class="gallery-photo-trigger block w-full cursor-zoom-in"
                  aria-label={`View ${photo.subject} full size`}
                >
                  {typeof photo.src === 'string' ? (
                    <img src={photo.src} alt={photo.alt} loading="lazy" class="w-full" />
                  ) : (
                    <Image
                      src={photo.src}
                      alt={photo.alt}
                      width={1600}
                      widths={[640, 1080, 1600]}
                      sizes="(min-width: 896px) 850px, 100vw"
                      quality={80}
                      loading="lazy"
                      class="w-full"
                    />
                  )}
                </button>
                <figcaption class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 px-6 py-5">
                  <div>
                    <p data-lightbox="subject" class="font-display text-lg text-nebula-teal">
                      {photo.subject}
                    </p>
                    <p data-lightbox="note" class="mt-1 text-sm text-ink-muted">
                      {photo.note}
                    </p>
                  </div>
                  <p
                    data-lightbox="photographer"
                    class="flex-none text-sm font-semibold text-ink-primary"
                  >
                    © {photo.photographer}
                  </p>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="border-t border-subtle bg-space-card/40">
    <div class="mx-auto max-w-3xl px-6 py-20 text-center">
      <h2 class="section-heading">Have an Image to Share?</h2>
      <p class="mx-auto mt-4 max-w-xl text-ink-muted">
        PAS members are always welcome to submit their astrophotography for the gallery — whether
        it's a first smart-telescope shot of the Moon or a multi-night deep-sky mosaic.
      </p>
      <a href="/contact" class="btn-primary mt-8">Submit Your Photo</a>
    </div>
  </section>

  <dialog id="gallery-lightbox" class="gallery-lightbox" aria-label="Photo viewer">
    <div class="gallery-lightbox-inner">
      <button
        type="button"
        id="gallery-lightbox-close"
        class="gallery-lightbox-close"
        aria-label="Close"
      >
        <svg
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="6" y1="6" x2="18" y2="18"></line>
          <line x1="18" y1="6" x2="6" y2="18"></line>
        </svg>
      </button>

      <div class="gallery-lightbox-media">
        <button
          type="button"
          id="gallery-lightbox-prev"
          class="gallery-lightbox-arrow gallery-lightbox-prev"
          aria-label="Previous photo"
        >
          <svg
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button
          type="button"
          id="gallery-lightbox-next"
          class="gallery-lightbox-arrow gallery-lightbox-next"
          aria-label="Next photo"
        >
          <svg
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>

        <img id="gallery-lightbox-image" alt="" />
      </div>

      <div class="gallery-lightbox-caption">
        <p id="gallery-lightbox-subject" class="font-display text-lg text-nebula-teal"></p>
        <p id="gallery-lightbox-note" class="mt-1 text-sm text-ink-muted"></p>
        <p id="gallery-lightbox-photographer" class="mt-1 text-sm font-semibold text-ink-primary">
        </p>
      </div>
    </div>
  </dialog>
</BaseLayout>

<style>
  .gallery-lightbox {
    width: min(1100px, calc(100vw - 2rem));
    max-height: calc(100vh - 4rem);
    margin: auto;
    border: 1px solid var(--color-border-subtle, #3a3a4a);
    border-radius: 1rem;
    background-color: var(--color-space-modal, #18233d);
    padding: 0;
    color: inherit;
    /* Only .gallery-lightbox-inner should scroll — without this, the
       dialog element and its inner wrapper both end up independently
       scrollable at the same max-height, and the browser draws a native
       scrollbar for each (visible as two side-by-side scrollbars). */
    overflow: hidden;
  }

  .gallery-lightbox-inner {
    position: relative;
    max-height: calc(100vh - 4rem);
    overflow-y: auto;
    padding: 1.25rem;
  }

  .gallery-lightbox-media {
    position: relative;
  }

  .gallery-lightbox-inner img {
    display: block;
    max-height: calc(100vh - 12rem);
    width: 100%;
    margin: 0 auto;
    object-fit: contain;
    border-radius: 0.5rem;
  }

  .gallery-lightbox-caption {
    padding-top: 1rem;
    text-align: center;
  }

  .gallery-lightbox-close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 1;
    display: flex;
    height: 2.25rem;
    width: 2.25rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    color: var(--color-ink-muted, #9ba3b7);
    transition: color 0.15s ease;
  }

  .gallery-lightbox-close:hover {
    color: var(--color-nebula-teal, #2dd4bf);
  }

  /* Centered on the image wrapper itself (not a viewport-height formula) so
     it stays correct regardless of a photo's aspect ratio — a wide Milky Way
     panorama and a near-square nebula shot render at very different heights
     within the same max-height cap. */
  .gallery-lightbox-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 1;
    display: flex;
    height: 2.75rem;
    width: 2.75rem;
    flex: none;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    border: 1px solid var(--color-border-subtle, #3a3a4a);
    background-color: var(--color-space-modal, #18233d);
    color: var(--color-ink-primary, #f1f3f8);
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .gallery-lightbox-arrow:hover {
    color: var(--color-nebula-teal, #2dd4bf);
    border-color: var(--color-nebula-teal, #2dd4bf);
  }

  .gallery-lightbox-prev {
    left: 0.75rem;
  }

  .gallery-lightbox-next {
    right: 0.75rem;
  }
</style>

<style is:global>
  .gallery-lightbox::backdrop {
    background-color: rgba(10, 14, 23, 0.7);
    backdrop-filter: blur(2px);
  }
</style>

<script>
  import { initGalleryLightbox } from '../scripts/gallery-lightbox';
  initGalleryLightbox();
</script>
