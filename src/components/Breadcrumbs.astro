---
const labels: Record<string, string> = {
  about: 'About',
  events: 'Events',
  'star-tours': 'Star Tours',
  'telescope-workshops': 'Telescope Workshops',
  'sky-conditions': 'Sky Conditions',
  learn: 'Learn Astronomy',
  exoplanets: 'Exoplanets',
  contact: 'Contact',
  join: 'Join',
  history: 'History',
  gallery: 'Gallery',
  leadership: 'Leadership',
  newsletters: 'Newsletters',
  'press-releases': 'Press Releases',
  'lecture-videos': 'Previous Lectures',
  asig: 'ASIG',
  bsig: 'BSIG',
};

const pathname = Astro.url.pathname;
const segments = pathname.split('/').filter(Boolean);

// BreadcrumbList JSON-LD alongside the visible <ol> below — same trail, so
// Google can show it in search results instead of the raw URL. Astro.site
// is configured in astro.config.mjs, so this is always an absolute URL.
const breadcrumbSchema = segments.length > 0 && {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
    ...segments.map((segment, index) => ({
      '@type': 'ListItem',
      position: index + 2,
      name: labels[segment] ?? segment,
      item: new URL('/' + segments.slice(0, index + 1).join('/'), Astro.site).toString(),
    })),
  ],
};
---

{breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}

{
  segments.length > 0 && (
    <nav aria-label="Breadcrumb" class="mx-auto max-w-6xl px-6 pt-6 text-sm text-ink-muted">
      <ol class="flex flex-wrap items-center gap-2">
        <li>
          <a href="/" class="hover:text-nebula-teal">
            Home
          </a>
        </li>
        {segments.map((segment, index) => {
          const href = '/' + segments.slice(0, index + 1).join('/');
          const isLast = index === segments.length - 1;
          const label = labels[segment] ?? segment;
          return (
            <>
              <li aria-hidden="true">/</li>
              <li>
                {isLast ? (
                  <span aria-current="page" class="text-ink-primary">
                    {label}
                  </span>
                ) : (
                  <a href={href} class="hover:text-nebula-teal">
                    {label}
                  </a>
                )}
              </li>
            </>
          );
        })}
      </ol>
    </nav>
  )
}
