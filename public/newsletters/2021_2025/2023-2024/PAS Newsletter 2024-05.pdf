<<
/Type /StructElem
/S /P
/ActualText <>
/Pg 9 0 R
/K [9]
>>
endobj
222 0 obj
<<
/Type /StructElem
/S /P
/ActualText (  His presentation focused on the relationship of faith and science and how they provide complementary, not contradictory, explanations for physical reality. )
/Pg 9 0 R
/K [10]
>>
endobj
