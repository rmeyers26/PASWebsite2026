---
interface Props {
  label: string;
  class?: string;
}

const { label, class: className } = Astro.props;
---

<p class={className ? `text-ink-muted ${className}` : 'text-ink-muted'}>
  {label} will be posted here as they are issued. In the meantime, see{' '}
  <a href="/events" class="text-nebula-teal hover:underline">
    upcoming events
  </a>{' '}
  or get in touch at{' '}
  <a href="mailto:info@pasaz.org" class="text-nebula-teal hover:underline">
    info@pasaz.org
  </a>
  .
</p>
